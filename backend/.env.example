# Qalarc OSINT Hub — backend configuration (copy to .env and source it, or export inline)
# All optional; sensible dev defaults apply.

# Bearer token required on /api/scan, /api/jobs* (strongly recommended when publicly hosted)
OSINT_HUB_TOKEN=

# Sliding-window rate limit per client IP: 'N/hour' | 'N/minute' | 'N/second'
OSINT_HUB_RATE_LIMIT=20/hour

# Concurrent scanner jobs (each job runs its tools sequentially)
OSINT_HUB_MAX_CONCURRENT=2

# Per-tool hard kill timeout in seconds
OSINT_HUB_TOOL_TIMEOUT=900

# CORS allow-all for dev (frontend on a different origin). Set 0 in production and
# serve the frontend from this backend, or front it with a same-origin proxy.
OSINT_HUB_CORS=1

# Opt-in for SearchPhone (needs API keys; see public_repos/osint/searchphone/example.env)
SEARCHPHONE_ENABLED=0
