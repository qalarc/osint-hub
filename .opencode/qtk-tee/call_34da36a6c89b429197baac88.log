00178| /* Disposable / public-SMS receiver sites — numbers appearing here have been
00179|    used for throwaway verification. Searched via Google site: dorks. */
00180| const DISPOSABLE_SITES = [
00181|   'receive-sms.com', 'receive-smsonline.com', 'sms-online.co', 'smstome.com',
00182|   'smsreceivefree.com', 'receive-a-sms.com', 'receivefreesms.com'
