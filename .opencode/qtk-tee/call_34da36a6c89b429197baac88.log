00059| const FETCH_TIMEOUT_MS = 8000;
00060| const CHUNK_SIZE = 10;
00061| const RATE_LIMIT = 30;              /* lite POSTs per hour per IP */
00062| const RATE_WINDOW_MS = 60 * 60 * 1000;
