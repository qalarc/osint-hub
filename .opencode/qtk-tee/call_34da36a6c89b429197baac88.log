00287| /* --------------------------------------------------------- endpoints ----- */
00288| 
00289| async function liteCheck(request) {
00290|   if (!rateAllow(clientIp(request))) {
00291|     return json(429, { error: 'rate limited: lite cloud mode allows ' + RATE_LIMIT + ' scans/hour per IP' });
00292|   }
00293|   const body = await readJsonBody(request);
00294|   if (!body || typeof body.value !== 'string') {
00295|     return json(400, { error: 'expected JSON body {"value":"<username>"}' });
00296|   }
00297|   const user = body.value.trim().replace(/^@+/, '');
00298|   if (!/^[A-Za-z0-9._-]{1,64}$/.test(user)) {
00299|     return json(400, { error: 'invalid username (allowed: A-Z a-z 0-9 . _ - , max 64 chars)' });
00300|   }
00301| 
00302|   const found = [];
00303|   /* chunked concurrency — see subrequest-budget notes in the header */
00304|   for (let i = 0; i < SITES.length; i += CHUNK_SIZE) {
00305|     const chunk = SITES.slice(i, i + CHUNK_SIZE);
00306|     const settled = await Promise.allSettled(chunk.map(s => probeSite(s, user)));
00307|     for (const r of settled) {
00308|       if (r.status === 'fulfilled' && r.value) found.push(r.value);
00309|     }
00310|   }
00311|   return json(200, { found: found });
00312| }
00313| 
00314| function litePivots(request) {
00315|   if (!rateAllow(clientIp(request))) {
00316|     return json(429, { error: 'rate limited: lite cloud mode allows ' + RATE_LIMIT + ' scans/hour per IP' });
00317|   }
00318|   return readJsonBody(request).then(body => {
00319|     if (!body || typeof body.value !== 'string') {
00320|       return json(400, { error: 'expected JSON body {"value":"+61425228338"}' });
00321|     }
00322|     const raw = body.value.trim();
00323|     const digits = raw.replace(/\D/g, '');
00324|     if (digits.length < 7 || digits.length > 15) {
00325|       return json(400, { error: 'invalid phone number (expected E.164-ish, 7-15 digits)' });
00326|     }
00327|     const e164 = '+' + digits;
00328| 
00329|     /* country guess — longest prefix first */
00330|     let country = null;
00331|     for (let len = 3; len >= 1; len--) {
00332|       const cc = digits.slice(0, len);
00333|       if (CC_TABLE[cc]) { country = CC_TABLE[cc]; break; }
00334|     }
00335| 
00336|     const info = [];
00337|     info.push({ key: 'Country (guessed)', value: country || 'unknown' });
00338|     info.push({ key: 'E.164', value: e164 });
00339|     info.push({ key: 'Digits', value: String(digits.length) });
00340| 
00341|     const d = '"' + digits + '"';
00342|     info.push({ key: 'Google — exact match', url: googleDork(d) });
00343|     info.push({ key: 'Social media (Facebook)', url: googleDork('site:facebook.com ' + d) });
00344|     info.push({ key: 'Social media (X/Twitter)', url: googleDork('site:twitter.com ' + d) });
00345|     info.push({ key: 'Social media (LinkedIn)', url: googleDork('site:linkedin.com ' + d) });
00346|     info.push({ key: 'Social media (Instagram)', url: googleDork('site:instagram.com ' + d) });
00347|     info.push({ key: 'Social media (VK)', url: googleDork('site:vk.com ' + d) });
00348|     info.push({ key: 'Reddit', url: googleDork('site:reddit.com ' + d) });
00349|     info.push({ key: 'WhatsApp — open chat', url: 'https://wa.me/' + digits });
00350|     DISPOSABLE_SITES.forEach(s => {
00351|       info.push({ key: 'Disposable SMS — ' + s, url: googleDork('site:' + s + ' ' + d) });
00352|     });
00353|     info.push({ key: 'DuckDuckGo — exact match', url: 'https://duckduckgo.com/?q=' + encodeURIComponent(d) });
00354|     info.push({ key: 'Bing — exact match', url: 'https://www.bing.com/search?q=' + encodeURIComponent(d) });
00355| 
00356|     return json(200, { info: info });
00357|   });
00358| }
00359| 
00360| /* ------------------------------------------------------------- routing --- */
00361| 
00362| export async function onRequest(context) {
00363|   const request = context.request;
00364|   const url = new URL(request.url);
00365|   /* prefix-agnostic routing: works at the root of a dedicated Pages project
00366|      (/api/...) AND scoped inside the qalarc.com site (/projects/osint-hub/api/...) */
00367|   const _i = url.pathname.indexOf('/api/');
00368|   const path = ((_i >= 0 ? url.pathname.slice(_i) : url.pathname) || '/').replace(/\/+$/, '') || '/';
00369|   const method = request.method.toUpperCase();
00370| 
00371|   if (method === 'OPTIONS') {
00372|     return new Response(null, { status: 204, headers: corsHeaders() });
00373|   }
00374| 
00375|   if (path === '/api/health' && method === 'GET') {
00376|     return json(200, HEALTH);
00377|   }
00378|   if (path === '/api/tools' && method === 'GET') {
00379|     return json(200, TOOLS);
00380|   }
00381|   if (path === '/api/lite/check' && method === 'POST') {
00382|     return liteCheck(request);
00383|   }
00384|   if (path === '/api/lite/pivots' && method === 'POST') {
00385|     return litePivots(request);
00386|   }
00387| 
00388|   /* everything else — /api/scan, /api/jobs/*, wrong methods, bare /api —
00389|      the full engine simply is not here. */
00390|   return json(501, {
00391|     error: 'full engine not available in lite mode — run the FastAPI backend for maigret/holehe/phoneinfoga'
00392|   });
00393| }
