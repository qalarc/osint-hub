00185| function googleDork(query) {
00186|   return 'https://www.google.com/search?q=' + encodeURIComponent(query);
00187| }
00188| 
00189| /* ------------------------------------------------------- rate limiting --- */
00190| 
00191| const rateMap = new Map(); /* ip → [timestamps] (isolate-lifetime, best effort) */
00192| 
00193| function rateAllow(key) {
00194|   const now = Date.now();
00195|   let hits = rateMap.get(key);
00196|   if (!hits) { hits = []; rateMap.set(key, hits); }
00197|   while (hits.length && hits[0] <= now - RATE_WINDOW_MS) hits.shift();
00198|   if (hits.length >= RATE_LIMIT) return false;
00199|   hits.push(now);
00200|   if (rateMap.size > 10000) {
00201|     for (const [k, v] of rateMap) {
00202|       if (!v.length || v[v.length - 1] <= now - RATE_WINDOW_MS) rateMap.delete(k);
00203|     }
00204|   }
00205|   return true;
00206| }
