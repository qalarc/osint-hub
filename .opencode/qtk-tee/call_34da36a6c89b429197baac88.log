00208| /* ------------------------------------------------------------- helpers --- */
00209| 
00210| function corsHeaders() {
00211|   return {
00212|     'Access-Control-Allow-Origin': '*',
00213|     'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
00214|     'Access-Control-Allow-Headers': 'Content-Type, Authorization',
00215|     'Access-Control-Max-Age': '86400'
00216|   };
00217| }
00218| 
00219| function json(status, obj) {
00220|   const headers = corsHeaders();
00221|   headers['Content-Type'] = 'application/json; charset=utf-8';
00222|   headers['Cache-Control'] = 'no-store';
00223|   return new Response(JSON.stringify(obj), { status: status, headers: headers });
00224| }
00225| 
00226| async function readJsonBody(request) {
00227|   try { return await request.json(); } catch (_) { return null; }
00228| }
00229| 
00230| function clientIp(request) {
00231|   return request.headers.get('CF-Connecting-IP') || 'anon';
00232| }
00233| 
00234| /* Does a redirect Location still point at the username? Tokens cover the
00235|    canonical patterns seen in the wild (/u, @u, -u, =u + urlencoded forms).
00236|    NB: very short usernames can substring-collide — acceptable for a heuristic
00237|    tool and far safer than treating every 3xx as "found". */
00238| function locationKeepsUser(loc, user) {
00239|   const l = loc.toLowerCase();
00240|   const u = user.toLowerCase();
00241|   return ['/' + u, '@' + u, '-' + u, '=' + u, '%40' + u, '%2f' + u]
00242|     .some(t => l.includes(t));
00243| }
00244| 
00245| /* Probe one site. Returns a found-item or null. One subrequest per call. */
00246| async function probeSite(def, user) {
00247|   const url = def.url(user);
00248|   let res;
00249|   try {
00250|     res = await fetch(url, {
00251|       method: 'GET',
00252|       redirect: 'manual',                 /* exactly 1 subrequest, no hop chain */
00253|       headers: { 'User-Agent': PROBE_UA, 'Accept': 'text/html,application/json' },
00254|       signal: AbortSignal.timeout(FETCH_TIMEOUT_MS)
00255|     });
00256|   } catch (_) {
00257|     return null;                          /* timeout / network error → not found */
00258|   }
00259| 
00260|   const status = res.status;
00261|   if (status >= 200 && status < 300) {
00262|     if (def.sniff) {
00263|       const len = Number(res.headers.get('content-length') || 0);
00264|       if (len > 3000000) return null;     /* huge body → skip, stay conservative */
00265|       let body = '';
00266|       try { body = await res.text(); } catch (_) { return null; }
00267|       if (def.sniff.absent && def.sniff.absent.some(m => body.includes(m))) return null;
00268|       if (def.sniff.present && !def.sniff.present.every(m => body.includes(m))) return null;
00269|     }
00270|     return { site: def.site, url: url, http_status: status };
00271|   }
00272| 
00273|   if (status >= 300 && status < 400) {
00274|     const loc = res.headers.get('location') || '';
00275|     if (!loc) return null;
00276|     if (def.rule === 'redirUser' && locationKeepsUser(loc, user)) {
00277|       return { site: def.site, url: url, http_status: status };
00278|     }
00279|     if (def.rule === 'roblox' && !/request-error/i.test(loc)) {
00280|       return { site: def.site, url: url, http_status: status };
00281|     }
00282|   }
00283| 
00284|   return null;                            /* 4xx/5xx/unmatched 3xx → not found */
00285| }
