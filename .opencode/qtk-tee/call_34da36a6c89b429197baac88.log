00165| /* +CC → country guess (longest-prefix match). Small by design. */
00166| const CC_TABLE = {
00167|   '1': 'US/CA', '7': 'RU/KZ', '20': 'EG', '27': 'ZA', '30': 'GR', '31': 'NL',
00168|   '32': 'BE', '33': 'FR', '34': 'ES', '36': 'HU', '39': 'IT', '40': 'RO',
00169|   '41': 'CH', '43': 'AT', '44': 'UK', '45': 'DK', '46': 'SE', '47': 'NO',
00170|   '48': 'PL', '49': 'DE', '52': 'MX', '55': 'BR', '61': 'AU', '62': 'ID',
00171|   '63': 'PH', '64': 'NZ', '66': 'TH', '81': 'JP', '82': 'KR', '84': 'VN',
00172|   '86': 'CN', '90': 'TR', '91': 'IN', '92': 'PK', '94': 'LK', '98': 'IR',
00173|   '212': 'MA', '234': 'NG', '254': 'KE', '351': 'PT', '353': 'IE',
00174|   '354': 'IS', '358': 'FI', '370': 'LT', '371': 'LV', '372': 'EE',
00175|   '375': 'BY', '380': 'UA', '971': 'AE', '966': 'SA', '972': 'IL', '995': 'GE'
00176| };
