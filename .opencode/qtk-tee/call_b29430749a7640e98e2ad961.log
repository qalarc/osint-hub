00001| """Job manager: runs scanner tools in worker threads, streams parsed events,
00002| persists job state to data/jobs/*.json."""
00003| 
00004| from __future__ import annotations
00005| 
00006| import collections
00007| import json
00008| import os
00009| import re
00010| import secrets
00011| import subprocess
00012| import threading
00013| import time
00014| from concurrent.futures import ThreadPoolExecutor
00015| from pathlib import Path
00016| 
00017| from tools import TOOLS, resolve_exe, strip_ansi
00018| 
00019| JOBS_DIR = Path(__file__).resolve().parent.parent / "data" / "jobs"
00020| JOBS_DIR.mkdir(parents=True, exist_ok=True)
00021| 
00022| MAX_EVENTS = 5000  # in-memory event cap per job
00023| MAX_JOBS_KEPT = 200  # prune persisted job files beyond this
00024| TOOL_HARD_TIMEOUT = int(os.environ.get("OSINT_HUB_TOOL_TIMEOUT", "900"))  # seconds
