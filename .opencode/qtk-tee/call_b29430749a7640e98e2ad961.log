00053| class Job:
00054|     def __init__(
00055|         self, type_: str, value: "str | dict", tools: list[str], options: dict
00056|     ):
00057|         self.id = "j_" + secrets.token_hex(4)
00058|         self.type = type_
00059|         self.value = value
00060|         self.tools = tools
00061|         self.options = options or {}
00062|         # queries: [(qtype, qvalue)] — "multi" jobs fan out to one run per (query, tool)
00063|         if type_ == "multi" and isinstance(value, dict):
00064|             self.queries = [
00065|                 (k, str(value[k]).strip())
00066|                 for k in ("username", "phone", "email", "image")
00067|                 if value.get(k)
00068|             ]
00069|         else:
00070|             self.queries = [(type_, str(value).strip())]
00071|         self.status = "queued"
00072|         self.created_at = time.time()
00073|         self.started_at: float | None = None
00074|         self.finished_at: float | None = None
00075|         self.error: str | None = None
00076|         self.results = [
00077|             {
00078|                 "tool": t,
00079|                 "qtype": qt,
00080|                 "qvalue": qv,
00081|                 "status": "pending",
00082|                 "found": [],
00083|                 "info": [],
00084|                 "error": None,
00085|             }
00086|             for (qt, qv) in self.queries
00087|             for t in tools
00088|             if TOOLS.get(t, {}).get("kind") == qt
00089|         ]
00090|         self.events: list[dict] = []
00091|         self.lock = threading.Lock()
00092| 
00093|     # -- events ------------------------------------------------------------
00094|     def emit(self, event: str, **data) -> None:
00095|         with self.lock:
00096|             self.events.append({"event": event, "ts": round(time.time(), 3), **data})
00097|             if len(self.events) > MAX_EVENTS:
00098|                 del self.events[: len(self.events) - MAX_EVENTS]
00099| 
00100|     def snapshot(self, log_tail: int = 50) -> dict:
00101|         with self.lock:
00102|             log_lines = [
00103|                 f"[{e.get('tool', '')}] {e.get('line', '')}"
00104|                 for e in self.events
00105|                 if e["event"] == "log"
00106|             ]
00107|             return {
00108|                 "id": self.id,
00109|                 "type": self.type,
00110|                 "value": self.value,
00111|                 "status": self.status,
00112|                 "created_at": self.created_at,
00113|                 "started_at": self.started_at,
00114|                 "finished_at": self.finished_at,
00115|                 "results": [dict(r) for r in self.results],
00116|                 "log_tail": "\n".join(log_lines[-log_tail:]),
00117|             }
00118| 
00119|     def persist(self) -> None:
00120|         try:
00121|             snap = self.snapshot(log_tail=0)
00122|             snap["events"] = self.events[-2000:]
00123|             tmp = JOBS_DIR / f"{self.id}.tmp"
00124|             tmp.write_text(json.dumps(snap))
00125|             tmp.replace(JOBS_DIR / f"{self.id}.json")
00126|         except Exception:
00127|             pass  # persistence is best-effort
