00027| class RateLimiter:
00028|     """Sliding-window limiter, spec 'N/hour' or 'N/minute'."""
00029| 
00030|     WINDOWS = {"hour": 3600, "minute": 60, "second": 1}
00031| 
00032|     def __init__(self, spec: str):
00033|         m = re.match(r"^(\d+)\s*/\s*(hour|minute|second)$", spec.strip().lower())
00034|         if not m:
00035|             raise ValueError(f"bad rate limit spec: {spec!r} (expected e.g. '20/hour')")
00036|         self.limit, self.window = int(m.group(1)), self.WINDOWS[m.group(2)]
00037|         self._hits: dict[str, collections.deque] = {}
00038|         self._lock = threading.Lock()
00039| 
00040|     def allow(self, key: str) -> tuple[bool, int]:
00041|         now = time.time()
00042|         with self._lock:
00043|             dq = self._hits.setdefault(key, collections.deque())
00044|             while dq and dq[0] <= now - self.window:
00045|                 dq.popleft()
00046|             if len(dq) >= self.limit:
00047|                 retry = int(self.window - (now - dq[0])) + 1
00048|                 return False, retry
00049|             dq.append(now)
00050|             return True, 0
