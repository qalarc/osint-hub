00099| export function renderMarkdown(src: string): string {
00100|   const lines = src.replace(/\r\n?/g, '\n').split('\n');
00101|   const out: string[] = [];
00102|   let i = 0;
00103|   let para: string[] = [];
00104| 
00105|   const flushPara = (): void => {
00106|     if (para.length > 0) {
00107|       out.push(`<p>${inline(para.join(' '))}</p>`);
00108|       para = [];
00109|     }
00110|   };
00111| 
00112|   while (i < lines.length) {
00113|     const line = lines[i];
00114| 
00115|     if (!line.trim()) { flushPara(); i++; continue; }
00116| 
00117|     // fenced code
00118|     const fence = /^\s*```(.*)$/.exec(line);
00119|     if (fence) {
00120|       flushPara();
00121|       const lang = fence[1].trim();
00122|       const body: string[] = [];
00123|       i++;
00124|       while (i < lines.length && !/^\s*```\s*$/.test(lines[i])) {
00125|         body.push(lines[i]);
00126|         i++;
00127|       }
00128|       i++; // closing fence (or EOF)
00129|       const cls = lang ? ` class="lang-${esc(lang)}"` : '';
00130|       out.push(`<pre><code${cls}>${esc(body.join('\n'))}</code></pre>`);
00131|       continue;
00132|     }
00133| 
00134|     // heading
00135|     const heading = /^(#{1,6})\s+(.*)$/.exec(line);
00136|     if (heading) {
00137|       flushPara();
00138|       const lvl = heading[1].length;
00139|       out.push(`<h${lvl}>${inline(heading[2])}</h${lvl}>`);
00140|       i++;
00141|       continue;
00142|     }
00143| 
00144|     // hr
00145|     if (HR_RE.test(line)) {
00146|       flushPara();
00147|       out.push('<hr>');
00148|       i++;
00149|       continue;
00150|     }
00151| 
00152|     // table (header row + separator row)
00153|     if (line.includes('|') && i + 1 < lines.length && TABLE_SEP_RE.test(lines[i + 1])) {
00154|       flushPara();
00155|       const header = splitRow(line);
00156|       i += 2;
00157|       const rows: string[][] = [];
00158|       while (i < lines.length && lines[i].includes('|') && lines[i].trim()) {
00159|         rows.push(splitRow(lines[i]));
00160|         i++;
00161|       }
00162|       const th = header.map((c) => `<th>${inline(c)}</th>`).join('');
00163|       const trs = rows.map((r) => {
00164|         const tds = header.map((_, ci) => `<td>${inline(r[ci] ?? '')}</td>`).join('');
00165|         return `<tr>${tds}</tr>`;
00166|       }).join('');
00167|       out.push(`<div class="md-table-wrap"><table><thead><tr>${th}</tr></thead><tbody>${trs}</tbody></table></div>`);
00168|       continue;
00169|     }
00170| 
00171|     // lists
00172|     if (LIST_ITEM_RE.test(line)) {
00173|       flushPara();
00174|       const res = parseList(lines, i);
00175|       out.push(res.html);
00176|       i = res.next;
00177|       continue;
00178|     }
00179| 
00180|     // blockquote (simple: consecutive > lines)
00181|     if (/^\s{0,3}>\s?/.test(line)) {
00182|       flushPara();
00183|       const body: string[] = [];
00184|       while (i < lines.length && /^\s{0,3}>\s?/.test(lines[i])) {
00185|         body.push(lines[i].replace(/^\s{0,3}>\s?/, ''));
00186|         i++;
00187|       }
00188|       out.push(`<blockquote><p>${inline(body.join(' '))}</p></blockquote>`);
00189|       continue;
00190|     }
00191| 
00192|     // paragraph line
00193|     para.push(line.trim());
00194|     i++;
00195|   }
00196|   flushPara();
00197|   return out.join('\n');
00198| }
00199| 
00200| /** Render markdown into an element (safe: escaped + scheme-whitelisted). */
00201| export function renderMarkdownInto(el: HTMLElement, src: string): void {
00202|   el.innerHTML = renderMarkdown(src);
00203| }
