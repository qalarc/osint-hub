00050| def resolve_exe(name: str) -> Optional[Path]:
00051|     """Find an executable: venv bin → backend/bin → PATH."""
00052|     for d in (VENV_BIN, BIN_DIR):
00053|         p = d / name
00054|         if p.is_file() and os.access(p, os.X_OK):
00055|             return p
00056|     found = shutil.which(name)
00057|     return Path(found) if found else None
