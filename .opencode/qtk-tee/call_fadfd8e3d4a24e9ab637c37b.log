00182| def _split_phone(value: str) -> tuple[str, str]:
00183|     """('+' + country_code, national_number). Uses phonenumbers when installed,
00184|     else a naive +CC split. ignorant's CLI wants them as separate positional args."""
00185|     try:
00186|         import phonenumbers  # optional dep, see requirements.txt
00187| 
00188|         n = phonenumbers.parse(value, None)
00189|         return f"+{n.country_code}", str(n.national_number)
00190|     except ImportError:
00191|         pass
00192|     v = re.sub(r"[ \-()]", "", value.strip())
00193|     m = re.match(r"^\+(\d{1,3})(\d{4,})$", v)
00194|     if not m:
00195|         raise ValueError("phone must be international format, e.g. +61425228338")
00196|     return f"+{m.group(1)}", m.group(2)
00197| 
00198| 
00199| def _ignorant(value: str, opts: dict):
00200|     cc, national = _split_phone(value)
00201|     return ["ignorant", cc, national], None
