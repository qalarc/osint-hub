00095| # --- phoneinfoga structured-info parser -------------------------------------
00096| # v3 scan output shape:
00097| #   Results for googlesearch
00098| #     Social media:            <- subsection headers end with ':' (skipped)
00099| #     URL: https://...         <- Google-dork pivots -> info items
00100| #   Results for local
00101| #     Raw local: 0425228338    <- key: value pairs -> info items
00102| #     Country: AU
00103| PIG_INFO_KEYS = {
00104|     "raw local",
00105|     "local",
00106|     "e164",
00107|     "international",
00108|     "country",
00109|     "carrier",
00110|     "line type",
00111|     "number type",
00112|     "region",
00113|     "timezone",
00114|     "valid",
00115|     "type",
00116|     "area",
00117| }
00118| 
00119| 
00120| def parse_phoneinfoga_info(line: str) -> Optional[dict]:
00121|     line = strip_ansi(line).strip()
00122|     if line.lower().startswith("url:"):
00123|         url = line.split(":", 1)[1].strip()
00124|         if url.startswith("http"):
00125|             return {"key": "search pivot", "url": url}
00126|         return None
00127|     if ":" in line and not line.endswith(":"):
00128|         k, v = line.split(":", 1)
00129|         k, v = k.strip(), v.strip()
00130|         if k.lower() in PIG_INFO_KEYS and v:
00131|             return {"key": k, "value": v}
00132|     return None
