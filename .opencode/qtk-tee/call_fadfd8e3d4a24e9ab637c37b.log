00060| def parse_plus_line(line: str, require_url: bool = True) -> Optional[dict]:
00061|     """Parse `[+] Site: https://url` style lines (sherlock/maigret/ignorant).
00062| 
00063|     require_url=True  → only lines containing a URL count as found (sherlock/maigret —
00064|                         avoids maigret's banner lines like '[+] Using sites database')
00065|     require_url=False → also accepts '[+] Site : note' (ignorant's phone-registered hits)
00066| 
00067|     Handles variants:
00068|       [+] GitHub: https://github.com/john
00069|       [+] tinder.com (Tinder): https://tinder.com/@john (200)
00070|       [+] snapchat : Phone number found          (ignorant, no URL)
00071|     """
00072|     line = strip_ansi(line)
00073|     if "[+]" not in line:
00074|         return None
00075|     text = line.split("[+]", 1)[1].strip()
00076|     m = URL_RE.search(text)
00077|     if m:
00078|         url = m.group(0).rstrip(".,);")
00079|         head = text[: m.start()].strip(" :-(").strip()
00080|         head = re.sub(r"\s*\([^)]*\)\s*$", "", head).strip()  # drop trailing "(domain)"
00081|         return {"site": head or url, "url": url}
00082|     if require_url:
00083|         return None
00084|     txt = text.rstrip(".")
00085|     if "[-]" in txt or "[x]" in txt or "not used" in txt.lower():
00086|         return (
00087|             None  # legend/summary lines, e.g. "[+] used, [-] not used, [x] rate limit"
00088|         )
00089|     if ":" in txt:
00090|         txt = txt.split(":", 1)[0].strip()
00091|     txt = txt.strip("()").strip()
00092|     return {"site": txt, "url": None} if txt else None
