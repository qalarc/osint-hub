00284|             spec.get("enabled_check") and spec["enabled_check"]()
00285|         )
00286|         out.append(
00287|             {
00288|                 "id": tid,
00289|                 "name": spec["name"],
00290|                 "kind": spec["kind"],
00291|                 "installed": installed,
00292|                 "description": spec["description"],
00293|                 "hint": spec["hint"],
00294|             }
00295|         )
00296|     return out
