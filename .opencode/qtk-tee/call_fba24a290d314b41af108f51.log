00121| def _short(exc: Exception) -> str:
00122|     """Compact one-line reason for a failure (no tracebacks in dots)."""
00123|     msg = str(exc).splitlines()[0] if str(exc) else exc.__class__.__name__
00124|     return f"{exc.__class__.__name__}: {msg}"[:160]
