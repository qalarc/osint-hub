01006| def genmedia_speak_kokoro(text: str, preset_voice: str) -> dict:
01007|     """POST /api/tts/synthesize with an explicit kokoro preset. Returns
01008|     {"ok": True, "url": str, "name": str, ...} or {"ok": False, "down": bool,
01009|     "detail": str}. Dedicated timeout: genmedia runs kokoro in a 60s-bounded
01010|     subprocess (cold model load can exceed 10s — measured 10.2s first call)."""
01011|     try:
