00945| def ai_audio_fetch_output(job: dict, dest_dir: Path) -> dict:
00946|     """Download a DONE job's wav into dest_dir. The job dict is the one from
00947|     ai_audio_job()["job"]; its result.url is pillar-relative
00948|     (/outputs/voice_clone/<f>.wav). Returns {"ok": True, "path": str} or
00949|     {"ok": False, "down": bool, "detail": str}."""
00950|     result = (job or {}).get("result") or {}
00951|     url = result.get("url") if isinstance(result, dict) else None
00952|     if not url:
00953|         return {"ok": False, "down": False, "detail": "job has no result.url"}
00954|     if url.startswith("http://") or url.startswith("https://"):
00955|         full = url
00956|     else:
00957|         full = BASES["ai_audio"] + url
00958|     try:
00959|         path = _fetch_file(full, Path(dest_dir))
00960|         return {"ok": True, "path": str(path), "detail": "ok"}
00961|     except Exception as exc:  # noqa: BLE001
00962|         return {
00963|             "ok": False,
00964|             "down": _is_connection_failure(exc),
00965|             "detail": f"ai_audio output fetch failed ({_short(exc)})",
00966|         }
