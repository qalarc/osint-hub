00524| # --------------------------------------------------------------------------
00525| # RunPod (elastic overflow — dormant until RUNPOD_API_KEY exists)
00526| # --------------------------------------------------------------------------
00527| 
00528| 
00529| def runpod_zimage(
00530|     prompt: str,
00531|     size: str = "1024*1024",
00532|     seed: int = -1,
00533|     image_url: str | None = None,
00534|     out_dir=None,
00535|     timeout: tuple = (10.0, 120.0),
00536| ) -> dict:
00537|     """Managed Z-Image Turbo on RunPod Public Endpoints — the platform's
00538|     image OVERFLOW path (local renders first; this serves when the rig is
00539|     busy or away). Confirmed shape (2026-09-09):
00540|     POST https://api.runpod.ai/v2/z-image-turbo/runsync
00541|     {input: {prompt, image?, size, seed}} -> {output: {image_url, cost}};
00542|     image URLs EXPIRE IN 7 DAYS — we download immediately.
00543| 
00544|     {"ok": True, "path", "cost", "execution_ms"} on success;
00545|     {"ok": False, "detail"} when dormant (no key) or unhappy. Never raises."""
00546|     key = os.environ.get("RUNPOD_API_KEY", "")
00547|     if not key:
00548|         return {
00549|             "ok": False,
00550|             "detail": "runpod dormant (no RUNPOD_API_KEY) — local renders only",
00551|         }
00552|     payload = {"input": {"prompt": prompt, "size": size, "seed": seed}}
00553|     if image_url:
00554|         payload["input"]["image"] = image_url
00555|     try:
00556|         status_code, data = http_json(
00557|             "POST",
00558|             "https://api.runpod.ai/v2/z-image-turbo/runsync",
00559|             json_body=payload,
00560|             headers={"authorization": f"Bearer {key}"},
00561|             timeout=timeout,
00562|         )
00563|     except Exception as exc:  # noqa: BLE001 — overflow is best-effort
00564|         return {"ok": False, "detail": f"runpod unreachable ({_short(exc)})"}
00565|     if status_code != 200 or not isinstance(data, dict):
00566|         return {"ok": False, "detail": f"runpod {status_code}: {str(data)[:120]}"}
00567|     out = data.get("output") or {}
00568|     url = out.get("image_url")
00569|     if data.get("status") != "COMPLETED" or not url:
00570|         return {
00571|             "ok": False,
00572|             "detail": f"runpod job {data.get('status')}: {str(data)[:120]}",
00573|         }
00574|     dest_dir = Path(out_dir) if out_dir else (records.store_root() / "runpod_cache")
00575|     dest_dir.mkdir(parents=True, exist_ok=True)
00576|     dest = dest_dir / f"zimg_{int(time.time() * 1000):x}.png"
00577|     try:
00578|         req = urllib.request.Request(url, headers={"user-agent": "goetica/0.1"})
00579|         with urllib.request.urlopen(req, timeout=timeout[1]) as resp:
00580|             dest.write_bytes(resp.read())
00581|     except Exception as exc:  # noqa: BLE001
00582|         return {"ok": False, "detail": f"image download failed ({_short(exc)})"}
00583|     from . import meter  # local import avoids a cycle at module load
00584| 
00585|     meter.record(
00586|         "image",
00587|         out.get("cost") or 0.005,
00588|         {"estimated": out.get("cost") is None, "engine": "z-image-turbo"},
00589|     )
00590|     return {
00591|         "ok": True,
00592|         "path": str(dest),
00593|         "cost": out.get("cost"),
00594|         "execution_ms": data.get("executionTime"),
00595|     }
