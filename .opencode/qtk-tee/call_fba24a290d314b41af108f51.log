00455| def archon_create_sandbox(name: str) -> dict:
00456|     """Create an archon sandbox. HTTP first (POST /api/sandboxes JSON
00457|     {"name": ...} — inspected shape); CLI fallback only when HTTP is
00458|     unreachable. Returns {"ok": bool, "sandbox": dict|None, "detail": str};
00459|     never raises."""
00460|     url = BASES["archon"] + "/api/sandboxes"
00461|     try:
00462|         status_code, data = http_json("POST", url, json_body={"name": name})
00463|         if status_code in (200, 201) and isinstance(data, dict):
00464|             return {
00465|                 "ok": True,
00466|                 "sandbox": data,
00467|                 "detail": f"created sandbox {data.get('id')}",
00468|             }
00469|         if status_code == 400:
00470|             return {
00471|                 "ok": False,
00472|                 "sandbox": None,
00473|                 "detail": f"archon 400: {str(data)[:120]}",
00474|             }
00475|         # Other HTTP errors: fall through to the CLI fallback, it may still work.
00476|     except Exception:  # noqa: BLE001 — unreachable -> CLI fallback
00477|         pass
00478|     result = _archon_cli_create(name)
00479|     if result["ok"]:
00480|         result["detail"] = f"created via CLI: {result['detail']}"
00481|     return result
