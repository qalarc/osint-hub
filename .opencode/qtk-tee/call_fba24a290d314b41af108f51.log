00421| def _archon_cli_create(name: str) -> dict:
00422|     """CLI fallback: python -m knowledge_core sandboxes create NAME
00423|     (verified to exist in Knowledge_systems/python/knowledge_core/cli.py).
00424|     15s timeout, never raises."""
00425|     env = dict(os.environ)
00426|     py_root = str(ARCHON_REPO / "python")
00427|     env["PYTHONPATH"] = py_root + (
00428|         os.pathsep + env["PYTHONPATH"] if env.get("PYTHONPATH") else ""
00429|     )
00430|     try:
00431|         proc = subprocess.run(
00432|             [sys.executable, "-m", "knowledge_core", "sandboxes", "create", name],
00433|             capture_output=True,
00434|             text=True,
00435|             timeout=15,
00436|             env=env,
00437|             cwd=py_root,
00438|         )
00439|         if proc.returncode == 0:
00440|             return {"ok": True, "sandbox": None, "detail": proc.stdout.strip()[:200]}
00441|         return {
00442|             "ok": False,
00443|             "sandbox": None,
00444|             "detail": f"archon CLI failed (rc={proc.returncode}): "
00445|             f"{(proc.stderr or proc.stdout).strip()[:120]}",
00446|         }
00447|     except Exception as exc:  # noqa: BLE001
00448|         return {
00449|             "ok": False,
00450|             "sandbox": None,
00451|             "detail": f"archon CLI error ({_short(exc)})",
00452|         }
00453| 
