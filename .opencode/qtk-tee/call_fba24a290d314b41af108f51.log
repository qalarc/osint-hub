00067| 
00068| def http_json(method: str, url: str, json_body=None, form=None, timeout=CALL_TIMEOUT):
00069|     """Perform one HTTP request; return (status:int, parsed_body) where
00070|     parsed_body is a decoded JSON value when possible, else raw text.
00071|     Raises urllib.error.* / OSError / json errors upward — callers wrap."""
00072|     data = None
00073|     headers = {"Accept": "application/json"}
00074|     if json_body is not None:
00075|         data = json.dumps(json_body).encode("utf-8")
00076|         headers["Content-Type"] = "application/json"
00077|     elif form is not None:
00078|         data = urllib.parse.urlencode(form).encode("utf-8")
00079|         headers["Content-Type"] = "application/x-www-form-urlencoded"
00080|     req = urllib.request.Request(url, data=data, headers=headers, method=method.upper())
00081|     with urllib.request.urlopen(req, timeout=max(timeout)) as resp:
00082|         raw = resp.read()
00083|     status = resp.status
00084|     try:
00085|         parsed = json.loads(raw.decode("utf-8")) if raw else None
00086|     except (json.JSONDecodeError, UnicodeDecodeError):
00087|         parsed = raw.decode("utf-8", "replace")
00088|     return status, parsed
