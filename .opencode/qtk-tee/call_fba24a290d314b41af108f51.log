00629| def ollama_chat(model: str, system: str, messages: list, timeout: float = 120.0) -> str:
00630|     """One chat completion (POST /api/chat, stream=false). `system` is
00631|     prepended as a system message (the persona card). num_ctx 8192 and
00632|     keep_alive 10m per contract. Returns the reply text.
00633|     Raises PillarError on any failure (web turns this into a 503)."""
00634|     full = ([{"role": "system", "content": system}] if system else []) + list(messages)
00635|     payload = {
00636|         "model": model,
00637|         "messages": full,
00638|         "stream": False,
00639|         "options": {"num_ctx": 8192},
00640|         "keep_alive": "10m",
00641|     }
00642|     try:
00643|         status_code, data = http_json(
00644|             "POST",
00645|             BASES["ollama"] + "/api/chat",
00646|             json_body=payload,
00647|             timeout=(5.0, float(timeout)),
00648|         )
00649|     except Exception as exc:  # noqa: BLE001
00650|         raise PillarError(f"ollama unreachable ({_short(exc)})") from exc
00651|     if status_code != 200 or not isinstance(data, dict):
00652|         raise PillarError(f"ollama error (HTTP {status_code}): {str(data)[:160]}")
00653|     content = (data.get("message") or {}).get("content")
00654|     if not isinstance(content, str):
00655|         raise PillarError(f"ollama returned no message.content: {str(data)[:160]}")
00656|     return content
00657| 
00658| 
00659| def ollama_chat_stream(model: str, system: str, messages: list, timeout: float = 240.0):
00660|     """Streaming chat completion (POST /api/chat, stream=true) — same hygiene
00661|     as ollama_chat (num_ctx 8192, keep_alive 10m, system prepended).
00662| 
00663|     Generator: yields {"delta": "<chunk>"} as tokens arrive, then a final
00664|     {"stats": {...}} (prompt_eval_count/eval_count/done_reason when ollama
00665|     reports them). Raises PillarError on connect/protocol failure BEFORE the
00666|     first delta; a torn stream mid-reply ends with whatever stats arrived —
00667|     callers keep the text they already received (honest partial output beats
00668|     a lost reply)."""
00669|     full = ([{"role": "system", "content": system}] if system else []) + list(messages)
00670|     payload = {
00671|         "model": model,
00672|         "messages": full,
00673|         "stream": True,
00674|         "options": {"num_ctx": 8192},
00675|         "keep_alive": "10m",
00676|     }
00677|     req = urllib.request.Request(
00678|         BASES["ollama"] + "/api/chat",
00679|         data=json.dumps(payload).encode("utf-8"),
00680|         headers={"Content-Type": "application/json"},
00681|         method="POST",
00682|     )
00683|     try:
00684|         resp = urllib.request.urlopen(req, timeout=float(timeout))
00685|     except Exception as exc:  # noqa: BLE001
00686|         raise PillarError(f"ollama unreachable ({_short(exc)})") from exc
00687|     try:
00688|         if resp.status != 200:
00689|             raise PillarError(f"ollama error (HTTP {resp.status})")
00690|         buf = ""
00691|         stats = {}
00692|         while True:
00693|             chunk = resp.read(8192)
00694|             if not chunk:
00695|                 break
00696|             buf += chunk.decode("utf-8", errors="replace")
00697|             while "\n" in buf:
00698|                 line, buf = buf.split("\n", 1)
00699|                 line = line.strip()
00700|                 if not line:
00701|                     continue
00702|                 try:
00703|                     ev = json.loads(line)
00704|                 except ValueError:
00705|                     continue  # keepalive junk — never kill a live stream
00706|                 if not isinstance(ev, dict):
00707|                     continue
00708|                 if ev.get("error"):
00709|                     raise PillarError(f"ollama stream error: {str(ev['error'])[:160]}")
00710|                 text = (ev.get("message") or {}).get("content")
00711|                 if ev.get("done"):
00712|                     stats = {
00713|                         k: ev.get(k)
00714|                         for k in ("prompt_eval_count", "eval_count", "done_reason")
00715|                         if ev.get(k) is not None
00716|                     }
00717|                     yield {"stats": stats}
00718|                     return
00719|                 if isinstance(text, str) and text:
00720|                     yield {"delta": text}
00721|         # stream ended without a done line — yield whatever stats we have
00722|         yield {"stats": stats}
00723|     finally:
00724|         try:
00725|             resp.close()
00726|         except Exception:  # noqa: BLE001
00727|             pass
00728| 
00729| 
00730| # --------------------------------------------------------------------------
00731| # ai_audio (VOICE) — F5-TTS clone jobs + voice profiles
00732| #
00733| # Verified shapes (ai_audio/ui/app.py, inspected 2026-09-06):
00734| #   POST /api/voice/clone  FORM (or multipart when a file is attached):
00735| #       gen_text (required), ref_text="", nfe_step=32, speed=1.0, seed=-1,
00736| #       voice_id="", name="", ref_audio=<file>  — exactly one of
00737| #       voice_id | ref_audio. Returns {"ok": true, "job_id": "<hex12>"}.
00738| #   GET  /api/jobs/{id}    -> {"ok": true, "job": {id, kind, status
00739| #       (queued|running|done|error|cancelled|waiting), params{gen_text,...},
00740| #       result{url, duration_s, elapsed_s, rtf}, error, progress, eta_s}}
00741| #       — result.url is pillar-relative, e.g. "/outputs/voice_clone/x.wav",
00742| #       served by the /outputs static mount.
00743| #   GET  /api/voices       -> {"ok": true, "voices": [{id, name, created,
00744| #       ref_text, notes, thumb_url, ref_url}]}
00745| #   POST /api/voices       FORM/multipart: name (required), ref_audio (file,
00746| #       required), ref_text, notes, thumbnail -> {"ok": true, "voice": {...}}
00747| #       SYNCHRONOUS (saves ref.wav + voice.json; no job).
00748| # --------------------------------------------------------------------------
00749| 
00750| 
00751| def multipart_encode(fields: dict, files: list) -> tuple:
00752|     """Encode (fields: {name: str}, files: [(name, filename, bytes, ctype)])
00753|     as multipart/form-data. Returns (body_bytes, content_type_header)."""
00754|     boundary = "----tulpa" + uuid.uuid4().hex
00755|     buf = io.BytesIO()
00756|     for key, val in fields.items():
00757|         if val is None:
00758|             continue
00759|         buf.write(
00760|             f'--{boundary}\r\nContent-Disposition: form-data; name="{key}"'
00761|             f"\r\n\r\n{val}\r\n".encode("utf-8")
00762|         )
00763|     for name, filename, blob, ctype in files:
00764|         buf.write(
00765|             f'--{boundary}\r\nContent-Disposition: form-data; name="{name}"; '
00766|             f'filename="{filename}"\r\nContent-Type: {ctype}\r\n\r\n'.encode("utf-8")
00767|         )
00768|         buf.write(blob)
00769|         buf.write(b"\r\n")
00770|     buf.write(f"--{boundary}--\r\n".encode("utf-8"))
00771|     return buf.getvalue(), f"multipart/form-data; boundary={boundary}"
00772| 
00773| 
00774| def _http_post_body(url: str, body: bytes, content_type: str, timeout=TTS_TIMEOUT):
00775|     """POST raw bytes with a chosen content type -> (status, parsed_body)."""
00776|     req = urllib.request.Request(
00777|         url,
00778|         data=body,
00779|         headers={"Accept": "application/json", "Content-Type": content_type},
00780|         method="POST",
00781|     )
00782|     with urllib.request.urlopen(req, timeout=max(timeout)) as resp:
00783|         raw = resp.read()
00784|         status = resp.status
00785|     try:
00786|         parsed = json.loads(raw.decode("utf-8")) if raw else None
00787|     except (json.JSONDecodeError, UnicodeDecodeError):
00788|         parsed = raw.decode("utf-8", "replace")
00789|     return status, parsed
00790| 
00791| 
00792| def _fetch_file(url: str, dest_dir: Path, timeout=TTS_FETCH_TIMEOUT) -> Path:
00793|     """GET url -> dest_dir/<url basename>. Raises on any failure."""
00794|     name = os.path.basename(urllib.parse.urlparse(url).path) or "audio.wav"
00795|     req = urllib.request.Request(url, headers={"Accept": "*/*"})
00796|     with urllib.request.urlopen(req, timeout=max(timeout)) as resp:
00797|         blob = resp.read()
00798|     dest_dir.mkdir(parents=True, exist_ok=True)
00799|     dest = dest_dir / name
00800|     dest.write_bytes(blob)
00801|     return dest
00802| 
00803| 
00804| def _is_connection_failure(exc: Exception) -> bool:
00805|     """True when the pillar was unreachable (down/timeout), as opposed to
00806|     answering with an HTTP error. Used to flag results {"down": True}."""
00807|     return isinstance(exc, (urllib.error.URLError, TimeoutError, OSError)) and not (
00808|         isinstance(exc, urllib.error.HTTPError)
00809|     )
00810| 
