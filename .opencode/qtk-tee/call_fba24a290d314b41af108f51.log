00858|         return {
00859|             "ok": False,
00860|             "down": False,
00861|             "detail": f"ai_audio refused (HTTP {status_code}): {str(data)[:120]}",
00862|         }
00863|     except Exception as exc:  # noqa: BLE001
00864|         return {
