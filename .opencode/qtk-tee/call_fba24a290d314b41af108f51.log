00132| def _probe(url: str) -> tuple[bool, str]:
00133|     """One GET; any HTTP response at all means the service is listening.
00134|     (404 from an unknown route still proves liveness.)"""
00135|     try:
00136|         status, _ = http_json("GET", url, timeout=STATUS_TIMEOUT)
00137|         return True, f"ok (HTTP {status})"
00138|     except urllib.error.HTTPError as exc:
00139|         # An HTTP error is still a response from a live service.
00140|         return True, f"ok (HTTP {exc.code})"
00141|     except Exception as exc:  # noqa: BLE001 — status() must never raise
00142|         return False, f"down ({_short(exc)})"
00143| 
00144| 
00145| def status() -> dict:
00146|     """{ollama, genmedia, ai_audio, archon, hub} each {"up": bool, "detail": str}."""
00147|     out = {}
00148|     for key, base in BASES.items():
00149|         if key == "ai_audio":
00150|             # No fixed health route known; "/" proves the port is listening.
00151|             up, detail = _probe(base + "/")
00152|         else:
00153|             up, detail = _probe(base + _STATUS_PATHS[key])
00154|         out[key] = {"up": up, "detail": detail}
00155|     return out
00156| 
00157| 
00158| _STATUS_PATHS = {
00159|     "ollama": "/api/tags",
00160|     "genmedia": "/api/characters",
00161|     "archon": "/api/sandboxes",
00162|     "hub": "/health",
00163| }
