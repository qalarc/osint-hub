00183| def genmedia_create_character(slug: str, name: str, canon_text: str) -> dict:
00184|     """Create a genmedia character. The real API is FORM-encoded (inspected):
00185|     name + description are required Form fields; the genmedia slug is derived
00186|     from the name via slugify(), so we pass the desired slug AS the name when
00187|     no display name is given, and we return the slug genmedia actually made.
00188|     Returns {"ok": bool, "exists": bool, "detail": str, "slug": str|None}."""
00189|     display = (name or slug).strip() or slug
00190|     form = {
00191|         "name": display,
00192|         "description": canon_text or "",
00193|         "style_tags": "",
00194|         "category": "",
00195|     }
00196|     url = BASES["genmedia"] + "/api/characters"
00197|     try:
00198|         status_code, data = http_json("POST", url, form=form)
00199|         if status_code in (200, 201):
00200|             real_slug = (data or {}).get("slug") if isinstance(data, dict) else None
00201|             return {
00202|                 "ok": True,
00203|                 "exists": False,
00204|                 "detail": f"created genmedia character {real_slug or display!r}",
00205|                 "slug": real_slug or display,
00206|                 "character": data,
00207|             }
00208|         if status_code == 409:
00209|             return {
00210|                 "ok": False,
00211|                 "exists": True,
00212|                 "detail": f"genmedia character already exists (409)",
00213|                 "slug": slug,
00214|                 "character": None,
00215|             }
00216|         if status_code == 422:  # defensive: API shape drift -> retry as JSON
00217|             status_code, data = http_json(
00218|                 "POST",
00219|                 url,
00220|                 json_body={"name": display, "description": canon_text or ""},
00221|             )
00222|             if status_code in (200, 201):
00223|                 real_slug = (data or {}).get("slug") if isinstance(data, dict) else None
00224|                 return {
00225|                     "ok": True,
00226|                     "exists": False,
00227|                     "detail": f"created genmedia character {real_slug or display!r} (JSON body)",
00228|                     "slug": real_slug or display,
00229|                     "character": data,
00230|                 }
00231|         return {
00232|             "ok": False,
00233|             "exists": False,
00234|             "detail": f"genmedia refused (HTTP {status_code}): {str(data)[:120]}",
00235|             "slug": slug,
00236|             "character": None,
00237|         }
00238|     except Exception as exc:  # noqa: BLE001
00239|         return {
00240|             "ok": False,
00241|             "exists": False,
00242|             "detail": f"genmedia unreachable ({_short(exc)})",
00243|             "slug": slug,
00244|             "character": None,
00245|         }
