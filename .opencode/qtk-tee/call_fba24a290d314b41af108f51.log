00871| def ai_audio_clone_job(
00872|     gen_text: str,
00873|     voice_id: str | None = None,
00874|     ref_audio_path: str | None = None,
00875|     ref_text: str = "",
00876|     speed: float = 1.0,
00877| ) -> dict:
00878|     """POST /api/voice/clone — submit an async F5-TTS job. Exactly one of
00879|     voice_id | ref_audio_path. Returns {"ok": True, "job_id": str} or
00880|     {"ok": False, "down": bool, "detail": str}."""
00881|     if bool(voice_id) == bool(ref_audio_path):
00882|         return {
00883|             "ok": False,
00884|             "down": False,
00885|             "detail": "exactly one of voice_id | ref_audio_path is required",
00886|         }
00887|     try:
00888|         url = BASES["ai_audio"] + "/api/voice/clone"
00889|         if ref_audio_path:
00890|             blob = Path(ref_audio_path).expanduser().read_bytes()
00891|             body, ctype = multipart_encode(
00892|                 {"gen_text": gen_text, "ref_text": ref_text or "", "speed": speed},
00893|                 [("ref_audio", Path(ref_audio_path).name, blob, "audio/wav")],
00894|             )
00895|             status_code, data = _http_post_body(url, body, ctype)
00896|         else:
00897|             status_code, data = http_json(
00898|                 "POST",
00899|                 url,
00900|                 form={
00901|                     "gen_text": gen_text,
00902|                     "ref_text": ref_text or "",
00903|                     "speed": speed,
00904|                     "voice_id": voice_id or "",
00905|                 },
00906|             )
00907|         if status_code in (200, 201) and isinstance(data, dict) and data.get("job_id"):
00908|             return {"ok": True, "job_id": data["job_id"], "detail": "submitted"}
00909|         return {
00910|             "ok": False,
00911|             "down": False,
00912|             "detail": f"ai_audio refused (HTTP {status_code}): {str(data)[:120]}",
00913|         }
00914|     except Exception as exc:  # noqa: BLE001
00915|         return {
00916|             "ok": False,
00917|             "down": _is_connection_failure(exc),
00918|             "detail": f"ai_audio unreachable ({_short(exc)})",
00919|         }
