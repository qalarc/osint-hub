00484| def archon_ask(
00485|     question: str,
00486|     sandbox_id: str | None = None,
00487|     libraries: list | None = None,
00488|     top_k: int = 6,
00489|     timeout: tuple = (3.0, 30.0),
00490| ) -> dict:
00491|     """Canon grounding: POST /api/ask (inspected shape 2026-09-06):
00492|     {"question": str, "sandbox_id"?: str, "libraries"?: [str], "top_k"?: int}
00493|     -> {"answer": str, "citations": [...], "libraries_searched": [...],
00494|         "backend": str, "found": bool, ...}.
00495| 
00496|     Returns {"ok": True, "answer", "citations", "backend", "found"} on a
00497|     usable answer; {"ok": False, "detail"} when archon is down/unhappy.
00498|     Never raises — story drafting degrades to ungrounded when this fails."""
00499|     body = {"question": question, "top_k": top_k}
00500|     if sandbox_id:
00501|         body["sandbox_id"] = sandbox_id
00502|     if libraries:
00503|         body["libraries"] = libraries
00504|     try:
00505|         status_code, data = http_json(
00506|             "POST", BASES["archon"] + "/api/ask", json_body=body, timeout=timeout
00507|         )
00508|     except Exception as exc:  # noqa: BLE001 — pillar-down is data, not a crash
00509|         return {"ok": False, "detail": f"archon unreachable ({_short(exc)})"}
00510|     if status_code == 200 and isinstance(data, dict):
00511|         answer = (data.get("answer") or "").strip()
00512|         if answer:
00513|             return {
00514|                 "ok": True,
00515|                 "answer": answer,
00516|                 "citations": data.get("citations") or [],
00517|                 "backend": data.get("backend"),
00518|                 "found": bool(data.get("found")),
00519|             }
00520|         return {"ok": False, "detail": "archon returned an empty answer"}
00521|     return {"ok": False, "detail": f"archon {status_code}: {str(data)[:120]}"}
