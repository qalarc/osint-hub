00334| def genmedia_job(job_id: str) -> dict | None:
00335|     """One GET /api/job/{id}. Verified job dict: {"id", "tool", "status",
00336|     "error", "outputs": [{"path", "url", "name"}, ...], "step",
00337|     "total_steps", "eta_s", ...}. Status values seen in app.py: queued |
00338|     running | done | error (image jobs; also scheduled/cancelling/paused/
00339|     downloading elsewhere). Terminal pair for renders: done | error; the
00340|     output FILESYSTEM path is outputs[0].path.
00341|     Returns a normalized {"id","status","error","outputs":[paths],"step",
00342|     "total_steps"} or None when the pillar is unreachable/404 — NEVER raises."""
00343|     try:
00344|         status_code, data = http_json(
00345|             "GET", BASES["genmedia"] + "/api/job/" + urllib.parse.quote(job_id)
00346|         )
00347|         if status_code == 200 and isinstance(data, dict):
00348|             outputs = [
00349|                 o.get("path") for o in (data.get("outputs") or []) if o.get("path")
00350|             ]
00351|             return {
00352|                 "id": data.get("id", job_id),
00353|                 "status": data.get("status", "unknown"),
00354|                 "error": data.get("error"),
00355|                 "outputs": outputs,
00356|                 "step": data.get("step", 0),
00357|                 "total_steps": data.get("total_steps", 0),
00358|             }
00359|         return None
00360|     except Exception:  # noqa: BLE001
00361|         return None
