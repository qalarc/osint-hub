00091| def archon_normalize_id(value: str) -> str:
00092|     """Collapse an archon sandbox name/library_id to a comparable token.
00093|     Archon prefixes libraries with 'project.sandbox.' and the platform writes
00094|     'project.character.<slug>' style ids in manifests — strip the known
00095|     prefixes from the FRONT (not the last dot-segment; the slug itself may
00096|     contain dots) and drop non-alphanumerics:
00097|       'project.sandbox.character_marrow' -> 'charactermarrow'
00098|       'project.character.marrow'         -> 'charactermarrow'
00099|       'character.marrow'                 -> 'charactermarrow'"""
00100|     s = (value or "").lower().strip()
00101|     if s.startswith("project.sandbox."):
00102|         s = s[len("project.sandbox.") :]
00103|     elif s.startswith("project."):
00104|         s = s[len("project.") :]
00105|     import re as _re
00106| 
00107|     return _re.sub(r"[^a-z0-9]+", "", s)
00108| 
00109| 
00110| def archon_id_matches(desired: str, fields: dict) -> bool:
00111|     """True when a sandbox dict (name/library_id/id) plausibly IS `desired`."""
00112|     for key in ("name", "library_id", "id"):
00113|         val = fields.get(key) or ""
00114|         if val and (
00115|             val == desired or archon_normalize_id(val) == archon_normalize_id(desired)
00116|         ):
00117|             return True
00118|     return False
00119| 
