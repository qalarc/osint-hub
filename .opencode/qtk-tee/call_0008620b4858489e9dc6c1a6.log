00057| impl EType {
00058|     /// All 22 variants, fixed order.
00059|     pub const ALL: [EType; 22] = [
00060|         Self::Person,
00061|         Self::Org,
00062|         Self::Username,
00063|         Self::Alias,
00064|         Self::Email,
00065|         Self::Phone,
00066|         Self::Domain,
00067|         Self::Subdomain,
