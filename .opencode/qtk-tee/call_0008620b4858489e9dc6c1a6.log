00083| 
00084|     pub fn as_str(self) -> &'static str {
00085|         match self {
00086|             Self::Person => "person",
00087|             Self::Org => "org",
00088|             Self::Username => "username",
00089|             Self::Alias => "alias",
00090|             Self::Email => "email",
00091|             Self::Phone => "phone",
00092|             Self::Domain => "domain",
00093|             Self::Subdomain => "subdomain",
00094|             Self::Ip => "ip",
00095|             Self::Asn => "asn",
00096|             Self::Cidr => "cidr",
00097|             Self::Website => "website",
00098|             Self::SocialProfile => "social_profile",
00099|             Self::Wallet => "wallet",
00100|             Self::Transaction => "transaction",
00101|             Self::Image => "image",
00102|             Self::Document => "document",
00103|             Self::Article => "article",
00104|             Self::Event => "event",
00105|             Self::Location => "location",
00106|             Self::Topic => "topic",
00107|             Self::Note => "note",
00108|         }
00109|     }
00110| 
00111|     /// Parses an etype string; see also the [`std::str::FromStr`] impl
00112|     /// (which maps failures to [`crate::NexusError::Invalid`]).
00113|     #[allow(clippy::should_implement_trait)] // inherent Option-returning form per CONTRACT §3
00114|     pub fn from_str(s: &str) -> Option<Self> {
00115|         Some(match s {
00116|             "person" => Self::Person,
00117|             "org" => Self::Org,
00118|             "username" => Self::Username,
00119|             "alias" => Self::Alias,
00120|             "email" => Self::Email,
00121|             "phone" => Self::Phone,
00122|             "domain" => Self::Domain,
00123|             "subdomain" => Self::Subdomain,
00124|             "ip" => Self::Ip,
00125|             "asn" => Self::Asn,
00126|             "cidr" => Self::Cidr,
00127|             "website" => Self::Website,
00128|             "social_profile" => Self::SocialProfile,
00129|             "wallet" => Self::Wallet,
00130|             "transaction" => Self::Transaction,
00131|             "image" => Self::Image,
00132|             "document" => Self::Document,
00133|             "article" => Self::Article,
00134|             "event" => Self::Event,
00135|             "location" => Self::Location,
00136|             "topic" => Self::Topic,
00137|             "note" => Self::Note,
00138|             _ => return None,
00139|         })
00140|     }
00141| }
00142| 
00143| impl std::fmt::Display for EType {
00144|     fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
00145|         f.write_str(self.as_str())
00146|     }
00147| }
00148| 
00149| impl std::str::FromStr for EType {
00150|     type Err = crate::NexusError;
00151|     fn from_str(s: &str) -> std::result::Result<Self, Self::Err> {
00152|         Self::from_str(s).ok_or_else(|| crate::NexusError::Invalid(format!("unknown etype: {s}")))
00153|     }
00154| }
