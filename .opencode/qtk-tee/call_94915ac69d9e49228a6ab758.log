00132| export class AnalysisPane {
00133|   readonly el: HTMLElement;
00134|   private bodyEl: HTMLElement;
00135|   private graph: CaseGraph | null = null;
00136| 
00137|   constructor(private readonly cb: {
00138|     caseId(): string | null;
00139|     entities(): Entity[];
00140|     labelOf(id: string): string;
00141|     navigate(entityId: string): void;
00142|     taskStarted(task: Task): void;
00143|   }) {
00144|     this.bodyEl = h('div', { class: 'pane-body analysis-body' });
00145|     this.el = h('section', { class: 'pane', id: 'pane-analysis', hidden: true },
00146|       h('header', { class: 'pane-head' },
00147|         h('span', { class: 'panel-label' }, 'analysis'),
00148|         h('span', { class: 'muted small' }, 'pagerank · degree · communities · pivots'),
00149|       ),
00150|       this.bodyEl,
00151|     );
00152|   }
00153| 
00154|   refreshFromGraph(g: CaseGraph): void {
00155|     this.graph = g;
00156|     this.render();
00157|   }
00158| 
00159|   private barGlyph(frac: number): string {
00160|     const filled = Math.max(0, Math.min(10, Math.round(frac * 10)));
00161|     return '▰'.repeat(filled) + '▱'.repeat(10 - filled);
00162|   }
00163| 
00164|   private render(): void {
00165|     const g = this.graph;
00166|     clear(this.bodyEl);
00167|     if (!g || g.nodes.length === 0) {
00168|       this.bodyEl.append(emptyState('nothing to analyze yet', 'add entities and relations to the case'));
00169|       return;
00170|     }
00171|     const ents = this.cb.entities();
00172|     const labelOf = (id: string): string => ents.find((x) => x.id === id)?.label ?? this.cb.labelOf(id);
00173|     const etypeOf = (id: string): string => String(ents.find((x) => x.id === id)?.etype ?? '');
00174| 
00175|     // ---- centrality ---------------------------------------------------
00176|     const pr = g.analysis.pagerank ?? {};
00177|     const deg = g.analysis.degree ?? {};
00178|     const ranked = Object.entries(pr).sort((a, b) => b[1] - a[1]).slice(0, 15);
00179|     const prMax = ranked[0]?.[1] ?? 1;
00180|     const table = h('table', { class: 'data-table' },
00181|       h('thead', {}, h('tr', {},
00182|         h('th', {}, '#'), h('th', {}, 'entity'), h('th', {}, 'etype'),
00183|         h('th', { class: 'num' }, 'deg'), h('th', { class: 'num' }, 'pagerank'), h('th', {}, '')),
00184|       ),
00185|     );
00186|     const tbody = h('tbody');
00187|     ranked.forEach(([id, score], i) => {
00188|       tbody.append(h('tr', {},
00189|         h('td', { class: 'mono muted' }, String(i + 1)),
00190|         h('td', { class: 'mono' }, truncate(labelOf(id), 34)),
00191|         h('td', {}, h('span', { class: 'chip', style: `border-color:${etypeColor(etypeOf(id))}55` }, etypeOf(id))),
00192|         h('td', { class: 'num mono' }, String(deg[id] ?? 0)),
00193|         h('td', { class: 'num mono' }, score.toFixed(4)),
00194|         h('td', { class: 'bar-glyph mono' }, this.barGlyph(prMax > 0 ? score / prMax : 0)),
00195|       ));
00196|     });
00197|     table.append(tbody);
00198| 
00199|     // ---- communities --------------------------------------------------
00200|     const comm = g.analysis.communities ?? {};
00201|     const groups = new Map<string, string[]>();
00202|     for (const [id, cidv] of Object.entries(comm)) {
00203|       const key = String(cidv);
00204|       const arr = groups.get(key) ?? [];
00205|       arr.push(id);
00206|       groups.set(key, arr);
00207|     }
00208|     const comps = g.analysis.components ?? [];
00209|     const commEl = h('div', { class: 'comm-wrap' },
00210|       h('div', { class: 'muted small' },
00211|         `${comps.length} connected component${comps.length === 1 ? '' : 's'} (${comps.map((c) => c.length).join(', ')})`),
00212|       ...(groups.size === 0
00213|         ? [h('div', { class: 'muted small pad6' }, 'no communities computed')]
00214|         : [...groups.entries()]
00215|           .sort((a, b) => b[1].length - a[1].length)
00216|           .map(([cid, ids]) => h('div', { class: 'comm-group' },
00217|             h('div', { class: 'panel-label' }, `community ${cid} · ${ids.length}`),
00218|             h('div', { class: 'comm-members' },
00219|               ...ids.map((id) => h('span', {
00220|                 class: 'chip chip-node', title: id,
00221|                 onclick: () => this.cb.navigate(id),
00222|               },
00223|               h('span', { class: 'dot dot-inline', style: `background:${etypeColor(etypeOf(id))}` }),
00224|               truncate(labelOf(id), 26)))),
00225|           ))),
00226|     );
00227| 
00228|     // ---- pivots ---------------------------------------------------------
00229|     const pivotsBox = h('div', { class: 'pivots-box' });
00230|     const sel = h('select', { class: 'input input-sm', 'aria-label': 'pivot entity' }) as HTMLSelectElement;
00231|     const pivotEntities = [...ents].sort((a, b) => (pr[b.id] ?? 0) - (pr[a.id] ?? 0)).slice(0, 15);
00232|     for (const e of pivotEntities) sel.append(h('option', { value: e.id }, `${e.etype}:${truncate(e.label, 26)}`));
00233|     const pivotList = h('div', { class: 'pivots-wrap open' });
00234|     const loadPivots = (): void => {
00235|       const cid = this.cb.caseId();
00236|       const eid = sel.value;
00237|       if (!cid || !eid) return;
00238|       clear(pivotList);
00239|       pivotList.append(h('div', { class: 'muted small pad6' }, 'loading…'));
00240|       void guarded(api.getPivots(cid, eid).then(({ pivots }) => {
00241|         clear(pivotList);
00242|         const ent = ents.find((x) => x.id === eid);
00243|         if (!ent) return;
00244|         if (pivots.length === 0) pivotList.append(h('div', { class: 'muted small pad6' }, 'no pivot suggestions for this entity'));
00245|         for (const p of pivots) pivotList.append(this.pivotCard(p, ent, cid));
00246|         return pivots;
00247|       }));
00248|     };
00249|     sel.addEventListener('change', loadPivots);
00250|     pivotsBox.append(
00251|       h('div', { class: 'row gap6' }, sel,
00252|         h('button', { class: 'btn btn-sm', type: 'button', onclick: loadPivots }, '↻')),
00253|       pivotList,
00254|     );
00255| 
00256|     this.bodyEl.append(
00257|       h('div', { class: 'analysis-grid' },
00258|         h('div', { class: 'panel panel-sub' },
00259|           h('header', { class: 'panel-head' }, h('span', { class: 'panel-label' }, 'centrality · top 15 pagerank')),
00260|           h('div', { class: 'table-scroll' }, table),
00261|         ),
00262|         h('div', { class: 'stack' },
00263|           h('div', { class: 'panel panel-sub' },
00264|             h('header', { class: 'panel-head' }, h('span', { class: 'panel-label' }, 'communities')),
00265|             commEl,
00266|           ),
00267|           h('div', { class: 'panel panel-sub' },
00268|             h('header', { class: 'panel-head' }, h('span', { class: 'panel-label' }, 'pivot suggestions')),
00269|             pivotsBox,
00270|           ),
00271|         ),
00272|       ),
00273|     );
00274|     loadPivots();
00275|   }
00276| 
00277|   private pivotCard(p: { entity_id: string; action: string; reason: string; priority: number }, ent: Entity, caseId: string): HTMLElement {
00278|     return h('div', { class: 'pivot-card' },
00279|       h('div', { class: 'row gap6' },
00280|         h('span', { class: 'chip chip-action mono' }, p.action),
00281|         h('span', { class: 'pivot-priority mono', title: `priority ${p.priority.toFixed(2)}` }, p.priority.toFixed(2)),
00282|       ),
00283|       h('div', { class: 'pivot-reason muted small' }, p.reason),
00284|       h('button', {
00285|         class: 'btn btn-sm btn-primary', type: 'button',
00286|         onclick: () => {
00287|           const { kind, params } = pivotToTask(p.action, ent);
00288|           void guarded(api.createTask(caseId, { kind, target: ent.id, params }).then((t) => {
00289|             this.cb.taskStarted(t);
00290|             return t;
00291|           }), `${kind} queued from pivot`);
00292|         },
00293|       }, 'run'),
00294|     );
00295|   }
00296| }
