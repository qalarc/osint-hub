00114|         h('div', { class: 'tl-title' }, ev.title),
00115|         entityLabel
00116|           ? h('a', {
00117|             class: 'tl-entity', href: '#', role: 'button',
00118|             onclick: (e: Event) => { e.preventDefault(); this.cb.navigate(entityLabel.id); },
00119|           },
00120|             h('span', { class: 'dot dot-inline', style: `background:${etypeColor(String(entityLabel.etype))}` }),
00121|             entityLabel.label)
00122|           : null,
00123|       ),
00124|     );
00125|   }
00126| 
00127|   currentCase(): string | null { return this.caseId; }
