00081|       this.listEl.append(h('div', { class: 'error-text small pad8' }, String(e instanceof Error ? e.message : e)));
00082|       return;
00083|     }
00084|     // entity select options
00085|     const sel = this.el.querySelector<HTMLSelectElement>('select[aria-label="linked entity (optional)"]');
00086|     if (sel) {
00087|       const cur = sel.value;
00088|       clear(sel);
00089|       sel.append(h('option', { value: '' }, '— entity —'));
00090|       for (const en of this.cb.entities()) {
00091|         sel.append(h('option', { value: en.id }, `${en.etype}:${truncate(en.label, 30)}`));
00092|       }
00093|       sel.value = cur;
