00225| 00224|     renderChips();
00226| 00225|     analysis.refreshFromGraph(g);
00227| 00226|     renderGraphEmpty(g.nodes.length === 0);
00228| 00227|     if (inspector.isOpen) void inspector.refresh();
00229| 00228|   }
