00291| 00290|     try {
00292| 00291|       const { path } = await api.getPath(state.caseId, a, id);
00293| 00292|       if (path && path.length > 0) {
00294| 00293|         graph.highlightPath(path);
00295| 00294|         pathBadge.hidden = false;
00296| 00295|         toast(`path found: ${path.length} node${path.length === 1 ? '' : 's'}`, 'ok', 2500);
00297| 00296|       } else {
00298| 00297|         graph.highlightPath(null);
00299| 00298|         pathBadge.hidden = true;
00300| 00299|         toast('no path between those nodes', 'warn');
00301| 00300|       }
