00209| 00208|       fetchGraph(false),
00210| 00209|       consolePane.refresh(id),
00211| 00210|     ]);
00212| 00211|     void timeline.refresh(id);
00213| 00212|     try {
00214| 00213|       const { case: c } = await api.getCase(id);
00215| 00214|       state.case = c;
00216| 00215|       caseNameEl.textContent = c.name;
00217| 00216|     } catch { /* graph fetch surfaced errors already */ }
00218| 00217|   }
00219| 00218| 
00220| 00219|   async function fetchGraph(relayout: boolean): Promise<void> {
