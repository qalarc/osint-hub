00279| 00278|   async function shiftPathTo(id: string): Promise<void> {
00280| 00279|     if (!state.pathAnchor) {
00281| 00280|       state.pathAnchor = id;
00282| 00281|       graph.setAnchor(id);
00283| 00282|       toast('path anchor set — shift-click a second node', 'info', 2500);
00284| 00283|       return;
