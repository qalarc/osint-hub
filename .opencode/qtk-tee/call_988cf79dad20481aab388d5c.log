00118| export function renderMarkdown(src: string): string {
00119|   const lines = src.replace(/\r\n?/g, '\n').split('\n');
00120|   const out: string[] = [];
00121|   let i = 0;
00122|   let para: string[] = [];
00123|   const headingIds = new Set<string>();
00124| 
00125|   const flushPara = (): void => {
00126|     if (para.length > 0) {
00127|       out.push(`<p>${inline(para.join(' '))}</p>`);
00128|       para = [];
00129|     }
00130|   };
00131| 
00132|   while (i < lines.length) {
00133|     const line = lines[i];
00134| 
00135|     if (!line.trim()) { flushPara(); i++; continue; }
00136| 
00137|     // fenced code
00138|     const fence = /^\s*```(.*)$/.exec(line);
00139|     if (fence) {
00140|       flushPara();
00141|       const lang = fence[1].trim();
00142|       const body: string[] = [];
00143|       i++;
00144|       while (i < lines.length && !/^\s*```\s*$/.test(lines[i])) {
00145|         body.push(lines[i]);
00146|         i++;
00147|       }
00148|       i++; // closing fence (or EOF)
00149|       const cls = lang ? ` class="lang-${esc(lang)}"` : '';
00150|       out.push(`<pre><code${cls}>${esc(body.join('\n'))}</code></pre>`);
00151|       continue;
00152|     }
00153| 
00154|     // heading (h2/h3 get a slug id for in-page anchors, e.g. the guide TOC)
00155|     const heading = /^(#{1,6})\s+(.*)$/.exec(line);
00156|     if (heading) {
00157|       flushPara();
00158|       const lvl = heading[1].length;
00159|       const inner = inline(heading[2]);
00160|       if (lvl === 2 || lvl === 3) {
00161|         const id = slugifyHeading(heading[2], headingIds);
00162|         out.push(`<h${lvl} id="${esc(id)}">${inner}</h${lvl}>`);
00163|       } else {
00164|         out.push(`<h${lvl}>${inner}</h${lvl}>`);
00165|       }
00166|       i++;
00167|       continue;
00168|     }
00169| 
00170|     // hr
00171|     if (HR_RE.test(line)) {
00172|       flushPara();
00173|       out.push('<hr>');
00174|       i++;
00175|       continue;
00176|     }
00177| 
00178|     // table (header row + separator row)
00179|     if (line.includes('|') && i + 1 < lines.length && TABLE_SEP_RE.test(lines[i + 1])) {
00180|       flushPara();
00181|       const header = splitRow(line);
00182|       i += 2;
00183|       const rows: string[][] = [];
00184|       while (i < lines.length && lines[i].includes('|') && lines[i].trim()) {
00185|         rows.push(splitRow(lines[i]));
00186|         i++;
00187|       }
00188|       const th = header.map((c) => `<th>${inline(c)}</th>`).join('');
00189|       const trs = rows.map((r) => {
00190|         const tds = header.map((_, ci) => `<td>${inline(r[ci] ?? '')}</td>`).join('');
00191|         return `<tr>${tds}</tr>`;
00192|       }).join('');
00193|       out.push(`<div class="md-table-wrap"><table><thead><tr>${th}</tr></thead><tbody>${trs}</tbody></table></div>`);
00194|       continue;
00195|     }
00196| 
00197|     // lists
00198|     if (LIST_ITEM_RE.test(line)) {
00199|       flushPara();
00200|       const res = parseList(lines, i);
00201|       out.push(res.html);
00202|       i = res.next;
00203|       continue;
00204|     }
00205| 
00206|     // blockquote (simple: consecutive > lines)
00207|     if (/^\s{0,3}>\s?/.test(line)) {
00208|       flushPara();
00209|       const body: string[] = [];
00210|       while (i < lines.length && /^\s{0,3}>\s?/.test(lines[i])) {
00211|         body.push(lines[i].replace(/^\s{0,3}>\s?/, ''));
00212|         i++;
00213|       }
00214|       out.push(`<blockquote><p>${inline(body.join(' '))}</p></blockquote>`);
00215|       continue;
00216|     }
00217| 
00218|     // paragraph line
00219|     para.push(line.trim());
00220|     i++;
00221|   }
00222|   flushPara();
00223|   return out.join('\n');
00224| }
00225| 
00226| /** Render markdown into an element (safe: escaped + scheme-whitelisted). */
00227| export function renderMarkdownInto(el: HTMLElement, src: string): void {
00228|   el.innerHTML = renderMarkdown(src);
00229| }
