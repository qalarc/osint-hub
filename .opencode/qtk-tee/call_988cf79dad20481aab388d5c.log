00001| /**
00002|  * Minimal in-house markdown renderer (no deps).
00003|  * Supports: h1–h6, bold/italic/strike, inline + fenced code, links,
00004|  * pipe tables, hr, ordered/unordered lists (with nesting), paragraphs.
00005|  * Everything is HTML-escaped before inline transforms; link schemes are
00006|  * whitelisted (http/https/mailto/relative). Returns an HTML string.
00007|  */
00008| 
00009| const ESC_MAP: Record<string, string> = {
00010|   '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
00011| };
00012| 
00013| function esc(s: string): string {
00014|   return s.replace(/[&<>"']/g, (c) => ESC_MAP[c] ?? c);
00015| }
00016| 
00017| function safeUrl(href: string): string | null {
00018|   const t = href.trim();
00019|   if (/^https?:\/\//i.test(t)) return t;
00020|   if (/^mailto:[^\s@]+@[^\s@]+$/i.test(t)) return t;
00021|   if (/^\/(?!\/)/.test(t)) return t; // same-origin relative, not protocol-relative
00022|   if (/^#[\w-]*$/.test(t)) return t;
00023|   return null;
00024| }
00025| 
00026| interface CodeSpan { placeholder: string; html: string }
00027| 
00028| function inline(raw: string): string {
00029|   let s = esc(raw);
00030|   const codes: CodeSpan[] = [];
00031|   s = s.replace(/`([^`\n]+)`/g, (_m, c: string) => {
00032|     const ph = `\u0000${codes.length}\u0000`;
00033|     codes.push({ placeholder: ph, html: `<code>${c}</code>` });
00034|     return ph;
00035|   });
00036|   // links: [text](url)
00037|   s = s.replace(/\[([^\]\n]*)\]\(([^)\s]+)\)/g, (_m, text: string, href: string) => {
00038|     const url = safeUrl(href);
00039|     if (!url) return text;
00040|     return `<a href="${url}" target="_blank" rel="noopener noreferrer">${text}</a>`;
00041|   });
00042|   // auto-link bare urls — intentional: only http(s), keeps dossiers clickable
00043|   s = s.replace(/(^|[\s(])(https?:\/\/[^\s<)]+)/g, (_m, pre: string, url: string) =>
00044|     `${pre}<a href="${url}" target="_blank" rel="noopener noreferrer">${url}</a>`);
00045|   s = s.replace(/\*\*([^*\n]+)\*\*/g, '<strong>$1</strong>');
00046|   s = s.replace(/(^|[^\w*])\*([^*\n]+)\*(?=[^\w*]|$)/g, '$1<em>$2</em>');
00047|   s = s.replace(/(^|\s)_([^_\n]+)_(?=\s|[.,;:!?)]|$)/g, '$1<em>$2</em>');
00048|   s = s.replace(/~~([^~\n]+)~~/g, '<del>$1</del>');
00049|   for (const c of codes) s = s.split(c.placeholder).join(c.html);
00050|   return s;
00051| }
00052| 
00053| const HR_RE = /^\s{0,3}(?:-[^\S\n]*-[^\S\n]*-|_[^\S\n]*_[^\S\n]*_|\*[^\S\n]*\*[^\S\n]*\*)[\s*_-]*$/;
00054| const LIST_ITEM_RE = /^(\s*)([-*+]|\d{1,9}[.)])\s+(.*)$/;
00055| const TABLE_SEP_RE = /^\s*\|?\s*:?-{2,}:?\s*(?:\|\s*:?-+:?\s*)*\|?\s*$/;
00056| 
00057| /**
00058|  * Anchor slug for h2/h3 (github-ish): lowercase, markdown tokens stripped,
00059|  * non-alphanumerics collapsed to '-', deduped per render. Returns an id that
00060|  * is safe for both the id attribute and querySelector('#…').
00061|  */
00062| function slugifyHeading(raw: string, used: Set<string>): string {
00063|   let s = raw
00064|     .toLowerCase()
00065|     .replace(/[`*_~[\]()!#]/g, '')
00066|     .replace(/[^a-z0-9]+/g, '-')
00067|     .replace(/^-+|-+$/g, '');
00068|   if (!s) s = 'section';
00069|   if (/^[0-9]/.test(s)) s = `s-${s}`;
00070|   let id = s;
00071|   for (let n = 2; used.has(id); n++) id = `${s}-${n}`;
00072|   used.add(id);
00073|   return id;
00074| }
00075| 
00076| function splitRow(line: string): string[] {
00077|   let t = line.trim();
00078|   if (t.startsWith('|')) t = t.slice(1);
00079|   if (t.endsWith('|')) t = t.slice(0, -1);
00080|   return t.split('|').map((c) => c.trim());
00081| }
00082| 
00083| function parseList(lines: string[], start: number): { html: string; next: number } {
00084|   const out: string[] = [];
00085|   const stack: Array<{ indent: number; ordered: boolean }> = [];
00086|   const closeTop = (): void => {
00087|     const top = stack.pop();
00088|     if (top) out.push(top.ordered ? '</ol>' : '</ul>');
00089|   };
00090|   let i = start;
00091|   for (; i < lines.length; i++) {
00092|     const m = LIST_ITEM_RE.exec(lines[i]);
00093|     if (!m) break;
00094|     const indent = m[1].replace(/\t/g, '  ').length;
00095|     const ordered = /\d/.test(m[2][0]);
00096|     const content = inline(m[3]);
00097|     for (;;) {
00098|       if (stack.length === 0) {
00099|         stack.push({ indent, ordered });
00100|         out.push(ordered ? '<ol>' : '<ul>');
00101|         break;
00102|       }
00103|       const top = stack[stack.length - 1];
00104|       if (indent > top.indent + 1) {
00105|         stack.push({ indent, ordered });
00106|         out.push(ordered ? '<ol>' : '<ul>');
00107|         continue;
00108|       }
00109|       if (indent < top.indent - 1 || (indent <= top.indent - 1)) { closeTop(); continue; }
00110|       break;
00111|     }
00112|     out.push(`<li>${content}</li>`);
00113|   }
00114|   while (stack.length > 0) closeTop();
00115|   return { html: out.join(''), next: i };
00116| }
