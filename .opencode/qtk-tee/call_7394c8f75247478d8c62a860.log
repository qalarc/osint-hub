00001| /** Tiny DOM helpers, toast system, formatting utils. No deps. */
00002| 
00003| export type Child = Node | string | number | boolean | null | undefined;
00004| 
00005| export function h(
00006|   tag: string,
00007|   attrs?: Record<string, unknown> | null,
00008|   ...children: Array<Child | Child[]>
00009| ): HTMLElement {
00010|   const el = document.createElement(tag);
00011|   if (attrs) {
00012|     for (const [k, v] of Object.entries(attrs)) {
00013|       if (v === null || v === undefined || v === false) continue;
00014|       if (k === 'class') el.className = String(v);
00015|       else if (k === 'text') el.textContent = String(v);
00016|       else if (k === 'html') el.innerHTML = String(v); // only with trusted content
00017|       else if (k.startsWith('on') && typeof v === 'function') {
00018|         el.addEventListener(k.slice(2).toLowerCase(), v as EventListener);
00019|       } else if (k === 'dataset' && typeof v === 'object') {
00020|         Object.assign(el.dataset, v as Record<string, string>);
00021|       } else if (v === true) el.setAttribute(k, '');
00022|       else el.setAttribute(k, String(v));
00023|     }
00024|   }
00025|   append(el, children);
00026|   return el;
00027| }
00028| 
00029| function append(el: HTMLElement, children: Array<Child | Child[]>): void {
00030|   for (const c of children) {
00031|     if (c === null || c === undefined || c === false) continue;
00032|     if (Array.isArray(c)) { append(el, c); continue; }
00033|     el.append(c instanceof Node ? c : document.createTextNode(String(c)));
00034|   }
00035| }
00036| 
00037| export function clear(el: HTMLElement): void {
00038|   while (el.firstChild) el.removeChild(el.firstChild);
00039| }
