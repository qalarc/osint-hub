00243| /** Debounce helper. */
00244| export function debounce<A extends unknown[]>(fn: (...a: A) => void, ms: number): (...a: A) => void {
00245|   let t: number | undefined;
00246|   return (...a: A) => {
00247|     window.clearTimeout(t);
00248|     t = window.setTimeout(() => fn(...a), ms);
00249|   };
00250| }
