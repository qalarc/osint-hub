00174| /** Prompt-style modal with a single text input. Resolves null on cancel. */
00175| export function inputModal(
00176|   title: string, label: string, placeholder = '',
00177| ): Promise<string | null> {
00178|   return new Promise((resolve) => {
00179|     let done = false;
00180|     const finish = (v: string | null): void => {
00181|       if (done) return;
00182|       done = true;
00183|       resolve(v);
00184|       m.close();
00185|     };
00186|     const input = h('input', { class: 'input', placeholder, type: 'text', spellcheck: 'false' }) as HTMLInputElement;
00187|     const m = openModal(title, (body, _close) => {
00188|       body.append(
00189|         h('label', { class: 'field-label' }, label),
00190|         input,
00191|         h('div', { class: 'row row-end gap8' },
00192|           h('button', { class: 'btn', type: 'button', onclick: () => finish(null) }, 'Cancel'),
00193|           h('button', {
00194|             class: 'btn btn-primary', type: 'button',
00195|             onclick: () => finish(input.value.trim()),
00196|           }, 'OK'),
00197|         ),
00198|       );
00199|       input.addEventListener('keydown', (e) => {
00200|         if (e.key === 'Enter') finish(input.value.trim());
00201|       });
00202|     });
00203|     void m;
00204|   });
00205| }
