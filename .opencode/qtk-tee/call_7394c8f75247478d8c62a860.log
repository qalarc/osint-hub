00041| // ---------------------------------------------------------------- toasts
00042| 
00043| export type ToastKind = 'info' | 'ok' | 'warn' | 'error';
00044| 
00045| let toastRoot: HTMLElement | null = null;
00046| 
00047| function ensureToastRoot(): HTMLElement {
00048|   if (!toastRoot) {
00049|     toastRoot = h('div', { id: 'toasts', 'aria-live': 'polite' });
00050|     document.body.append(toastRoot);
00051|   }
00052|   return toastRoot;
00053| }
00054| 
00055| let lastToastAt: Record<string, number> = {};
00056| 
00057| export function toast(msg: string, kind: ToastKind = 'info', ms = 4200): void {
00058|   // rate-limit identical messages (e.g. SSE-driven retries)
00059|   const now = Date.now();
00060|   if (lastToastAt[msg] && now - lastToastAt[msg] < 3000) return;
00061|   lastToastAt[msg] = now;
00062|   const root = ensureToastRoot();
00063|   const t = h('div', { class: `toast toast-${kind}`, role: 'status' },
00064|     h('span', { class: 'toast-msg' }, msg),
00065|     h('button', {
00066|       class: 'toast-x', 'aria-label': 'dismiss', type: 'button',
00067|       onclick: () => t.remove(),
00068|     }, '✕'),
00069|   );
00070|   root.append(t);
00071|   requestAnimationFrame(() => t.classList.add('in'));
00072|   window.setTimeout(() => {
00073|     t.classList.remove('in');
00074|     window.setTimeout(() => t.remove(), 300);
00075|   }, ms);
00076|   // gc the rate-limit map
00077|   if (Object.keys(lastToastAt).length > 64) lastToastAt = {};
00078| }
