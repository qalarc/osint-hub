00214| export function downloadText(filename: string, text: string, mime = 'text/markdown'): void {
00215|   const blob = new Blob([text], { type: `${mime};charset=utf-8` });
00216|   const url = URL.createObjectURL(blob);
00217|   const a = h('a', { href: url, download: filename }) as HTMLAnchorElement;
00218|   document.body.append(a);
00219|   a.click();
00220|   a.remove();
00221|   window.setTimeout(() => URL.revokeObjectURL(url), 2000);
00222| }
