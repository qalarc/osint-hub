00144| /** Generic centered modal. Returns {close}. Backdrop click / Esc close. */
00145| export function openModal(
00146|   title: string,
00147|   build: (body: HTMLElement, close: () => void) => void,
00148|   opts?: { wide?: boolean },
00149| ): { close: () => void } {
00150|   const backdrop = h('div', { class: 'modal-backdrop' });
00151|   const close = (): void => {
00152|     backdrop.classList.remove('in');
00153|     window.setTimeout(() => backdrop.remove(), 150);
00154|     document.removeEventListener('keydown', onKey);
00155|   };
00156|   const onKey = (e: KeyboardEvent): void => { if (e.key === 'Escape') close(); };
00157|   document.addEventListener('keydown', onKey);
00158|   const panel = h('div', { class: `modal${opts?.wide ? ' modal-wide' : ''}`, role: 'dialog', 'aria-modal': 'true' },
00159|     h('div', { class: 'modal-head' },
00160|       h('span', { class: 'panel-label' }, title),
00161|       h('button', { class: 'btn btn-ghost btn-sm', onclick: close, 'aria-label': 'close', type: 'button' }, '✕'),
00162|     ),
00163|     ((): HTMLElement => { const b = h('div', { class: 'modal-body' }); build(b, close); return b; })(),
00164|   );
00165|   backdrop.append(panel);
00166|   backdrop.addEventListener('mousedown', (e) => { if (e.target === backdrop) close(); });
00167|   document.body.append(backdrop);
00168|   requestAnimationFrame(() => backdrop.classList.add('in'));
00169|   const first = panel.querySelector<HTMLElement>('input, textarea, select, button');
00170|   first?.focus();
00171|   return { close };
00172| }
