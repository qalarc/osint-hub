00224| export async function copyText(text: string): Promise<boolean> {
00225|   try {
00226|     await navigator.clipboard.writeText(text);
00227|     return true;
00228|   } catch {
00229|     try {
00230|       const ta = h('textarea', { style: 'position:fixed;opacity:0' }) as HTMLTextAreaElement;
00231|       ta.value = text;
00232|       document.body.append(ta);
00233|       ta.select();
00234|       const ok = document.execCommand('copy');
00235|       ta.remove();
00236|       return ok;
00237|     } catch {
00238|       return false;
00239|     }
00240|   }
00241| }
