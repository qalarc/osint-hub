00080| /** Run a promise; toast errors (esp. ApiError); optional success message. */
00081| export async function guarded<T>(
00082|   p: Promise<T>,
00083|   okMsg?: string | ((result: T) => string),
00084| ): Promise<T | undefined> {
00085|   try {
00086|     const r = await p;
00087|     if (okMsg) toast(typeof okMsg === 'function' ? okMsg(r) : okMsg, 'ok');
00088|     return r;
00089|   } catch (e) {
00090|     if (e instanceof Error && e.name === 'AbortError') return undefined;
00091|     toast(e instanceof Error ? e.message : String(e), 'error');
00092|     return undefined;
00093|   }
00094| }
