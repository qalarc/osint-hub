00001| /**
00002|  * Typed API client for the nexus-server HTTP surface (CONTRACT.md §4).
00003|  * Same-origin only; every fetch is cache: no-store; `{"error": ...}` bodies
00004|  * become ApiError for the UI to toast.
00005|  */
00006| import type {
00007|   Case, CaseGraph, Entity, EntityDetail, Evidence, Health, LayaRanked,
00008|   PivotSuggestion, Relation, Task, TimelineEvent, NexusSettings,
00009| } from './types';
00010| 
00011| const BASE = '/api';
00012| 
00013| export class ApiError extends Error {
00014|   readonly status: number;
00015|   constructor(status: number, message: string) {
00016|     super(message);
00017|     this.name = 'ApiError';
00018|     this.status = status;
00019|   }
00020| }
00021| 
00022| function errFromBody(status: number, body: unknown): ApiError {
00023|   if (body && typeof body === 'object' && 'error' in body) {
00024|     const e = (body as { error: unknown }).error;
00025|     if (typeof e === 'string' && e) return new ApiError(status, e);
00026|   }
00027|   return new ApiError(status, `${status} ${STATUS_TEXT[status] ?? ''}`.trim());
00028| }
00029| 
00030| const STATUS_TEXT: Record<number, string> = {
00031|   400: 'bad request', 401: 'unauthorized', 403: 'forbidden', 404: 'not found',
00032|   409: 'conflict', 422: 'unprocessable', 500: 'internal error', 502: 'bad gateway',
00033|   503: 'unavailable',
00034| };
00035| 
00036| async function request<T>(path: string, init?: RequestInit): Promise<T> {
00037|   let res: Response;
00038|   try {
00039|     res = await fetch(BASE + path, { cache: 'no-store', ...init });
00040|   } catch (e) {
00041|     throw new ApiError(0, `network error — is the nexus server up? (${String(e)})`);
00042|   }
00043|   const text = await res.text();
00044|   let body: unknown = null;
00045|   if (text.length > 0) {
00046|     try { body = JSON.parse(text); } catch { body = null; }
00047|   }
00048|   if (!res.ok) throw errFromBody(res.status, body);
00049|   return body as T;
00050| }
00051| 
00052| async function requestText(path: string): Promise<string> {
00053|   let res: Response;
00054|   try {
00055|     res = await fetch(BASE + path, { cache: 'no-store' });
00056|   } catch (e) {
00057|     throw new ApiError(0, `network error — is the nexus server up? (${String(e)})`);
00058|   }
00059|   const text = await res.text();
00060|   if (!res.ok) {
00061|     let body: unknown = null;
00062|     try { body = JSON.parse(text); } catch { body = null; }
00063|     throw errFromBody(res.status, body);
00064|   }
00065|   return text;
00066| }
00067| 
00068| function json(method: string, payload?: unknown): RequestInit {
00069|   return {
00070|     method,
00071|     headers: { 'content-type': 'application/json' },
00072|     body: payload === undefined ? undefined : JSON.stringify(payload),
00073|   };
00074| }
00075| 
00076| const enc = encodeURIComponent;
