00210| 00209|     try {
00211| 00210|       const { case: c } = await api.getCase(id);
00212| 00211|       state.case = c;
00213| 00212|       caseNameEl.textContent = c.name;
00214| 00213|     } catch { /* graph fetch surfaced errors already */ }
00215| 00214|   }
