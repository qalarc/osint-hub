00288| 00287|     try {
00289| 00288|       const { path } = await api.getPath(state.caseId, a, id);
00290| 00289|       if (path && path.length > 0) {
00291| 00290|         graph.highlightPath(path);
00292| 00291|         pathBadge.hidden = false;
00293| 00292|         toast(`path found: ${path.length} node${path.length === 1 ? '' : 's'}`, 'ok', 2500);
00294| 00293|       } else {
00295| 00294|         graph.highlightPath(null);
00296| 00295|         pathBadge.hidden = true;
00297| 00296|         toast('no path between those nodes', 'warn');
00298| 00297|       }
00299| 00298|     } catch (e) {
