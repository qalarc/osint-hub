00276| 00275|   async function shiftPathTo(id: string): Promise<void> {
00277| 00276|     if (!state.pathAnchor) {
00278| 00277|       state.pathAnchor = id;
00279| 00278|       graph.setAnchor(id);
00280| 00279|       toast('path anchor set — shift-click a second node', 'info', 2500);
00281| 00280|       return;
00282| 00281|     }
00283| 00282|     const a = state.pathAnchor;
00284| 00283|     state.pathAnchor = null;
00285| 00284|     graph.setAnchor(null);
00286| 00285|     if (a === id) return;
