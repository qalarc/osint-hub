00442| #[cfg(test)]
00443| mod tests {
00444|     use super::*;
00445| 
00446|     #[test]
00447|     fn etype_has_22_fixed_variants_and_round_trips() {
00448|         assert_eq!(EType::ALL.len(), 22);
00449|         for e in EType::ALL {
00450|             assert_eq!(EType::from_str(e.as_str()), Some(e), "round-trip {}", e);
00451|             let json = serde_json::to_string(&e).unwrap();
00452|             assert_eq!(json, format!("\"{}\"", e.as_str()));
00453|             assert_eq!(serde_json::to_string(&e).unwrap(), json);
00454|             let back: EType = serde_json::from_str(&json).unwrap();
00455|             assert_eq!(back, e);
00456|         }
00457|         assert!(EType::from_str("bogus").is_none());
00458|         assert!("bogus".parse::<EType>().is_err());
00459|     }
00460| 
00461|     #[test]
00462|     fn canonical_rels_count() {
00463|         assert_eq!(CANONICAL_RELS.len(), 16);
00464|         assert!(CANONICAL_RELS.contains(&"resolves_to"));
00465|         assert!(CANONICAL_RELS.contains(&"posted_on"));
00466|     }
00467| 
00468|     #[test]
00469|     fn new_types_have_contract_defaults() {
00470|         let ne: NewEntity = serde_json::from_str(r#"{"etype":"username","label":"johndoe"}"#).unwrap();
00471|         assert_eq!(ne.etype, EType::Username);
00472|         assert_eq!(ne.confidence, 1.0);
00473|         assert!(!ne.pinned);
00474|         assert_eq!(ne.data, serde_json::json!({}));
00475| 
00476|         let nr: NewRelation = serde_json::from_str(
00477|             r#"{"case_id":"c_1","src":"e_1","dst":"e_2","rel":"uses","source":"hub:sherlock"}"#,
00478|         )
00479|         .unwrap();
00480|         assert_eq!(nr.weight, 1.0);
00481|         assert_eq!(nr.confidence, 1.0);
00482|         assert_eq!(nr.source.as_deref(), Some("hub:sherlock"));
00483| 
00484|         let nv: NewEvidence = serde_json::from_str(
00485|             r#"{"case_id":"c_1","subject":"e_1","kind":"tool_result"}"#,
00486|         )
00487|         .unwrap();
00488|         assert_eq!(nv.confidence, 1.0);
00489|         assert_eq!(nv.raw, serde_json::json!({}));
00490|     }
00491| 
00492|     #[test]
00493|     fn entity_json_matches_contract_shape() {
00494|         let json = r#"{"id":"e_ab12","case_id":"c_1","etype":"username","label":"johndoe","data":{},"confidence":1.0,"pinned":false,"first_seen":"2026-09-22T00:00:00Z","last_seen":"2026-09-22T00:00:00Z"}"#;
00495|         let e: Entity = serde_json::from_str(json).unwrap();
00496|         assert_eq!(e.etype, EType::Username);
00497|         assert_eq!(e.id, "e_ab12");
00498|     }
00499| }
