00010| #[serde(rename_all = "snake_case")]
00011| pub enum EType {
00012|     Person,
00013|     Org,
00014|     Username,
00015|     Alias,
00016|     Email,
00017|     Phone,
00018|     Domain,
00019|     Subdomain,
00020|     Ip,
00021|     Asn,
00022|     Cidr,
00023|     Website,
00024|     SocialProfile,
00025|     Wallet,
00026|     Transaction,
00027|     Image,
00028|     Document,
00029|     Article,
00030|     Event,
00031|     Location,
00032|     Topic,
00033|     Note,
00034| }
00035| 
00036| /// Canonical relation types (CONTRACT §2). `rel` stays a free-form string;
00037| /// these are the well-known ones (used for sentence templates in reports).
00038| pub const CANONICAL_RELS: &[&str] = &[
00039|     "uses",
00040|     "owns",
00041|     "resolves_to",
00042|     "subdomain_of",
00043|     "registered_to",
00044|     "mentions",
00045|     "contacted",
00046|     "same_as",
00047|     "paid_to",
00048|     "located_in",
00049|     "member_of",
00050|     "works_at",
00051|     "sourced_from",
00052|     "derived_from",
00053|     "related_to",
00054|     "posted_on",
00055| ];
