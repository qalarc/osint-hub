00023| /** hub_scan kind for an entity's etype */
00024| function scanKindFor(etype: string): string {
00025|   if (etype === 'email') return 'email';
00026|   if (etype === 'phone') return 'phone';
00027|   if (etype === 'image') return 'image';
00028|   return 'username'; // username / alias / person / fallback
00029| }
00030| 
00031| /** flowsint enrichers suggested by etype */
00032| function enrichersFor(etype: string): string[] {
00033|   switch (etype) {
00034|     case 'domain':
00035|     case 'subdomain':
00036|       return ['subdomain_discovery', 'dns_lookup', 'whois_lookup'];
00037|     case 'ip':
00038|       return ['reverse_dns', 'geoip', 'ports'];
00039|     case 'website':
00040|       return ['http_headers', 'tech_stack'];
00041|     case 'email':
00042|       return ['breach_check', 'gravatar'];
00043|     case 'phone':
00044|       return ['phone_lookup', 'carrier'];
00045|     case 'username':
00046|     case 'person':
00047|       return ['account_search'];
00048|     case 'wallet':
00049|       return ['balance', 'tx_history'];
00050|     default:
00051|       return ['basic'];
00052|   }
00053| }
00054| 
00055| /** map a pivot action like "flowsint_enrich:subdomain_discovery" to a task */
00056| export function pivotToTask(
00057|   action: string, entity: Entity,
00058| ): { kind: string; params: Record<string, unknown> } {
00059|   const i = action.indexOf(':');
00060|   const head = i >= 0 ? action.slice(0, i) : action;
00061|   const rest = i >= 0 ? action.slice(i + 1) : null;
00062|   switch (head) {
00063|     case 'hub_scan':
00064|       return { kind: 'hub_scan', params: { scan: rest ?? 'username', value: entity.label } };
00065|     case 'flowsint_enrich':
00066|       return { kind: 'flowsint_enrich', params: { enrichers: rest ? [rest] : enrichersFor(String(entity.etype)) } };
00067|     case 'openplanter_research':
00068|       return { kind: 'openplanter_research', params: rest ? { question: rest } : {} };
00069|     case 'archon_ground':
00070|       return { kind: 'archon_ground', params: rest ? { question: rest } : {} };
00071|     case 'web_pivots':
00072|       return { kind: 'web_pivots', params: {} };
00073|     default:
00074|       return { kind: head, params: rest ? { scan: rest } : {} };
00075|   }
00076| }
