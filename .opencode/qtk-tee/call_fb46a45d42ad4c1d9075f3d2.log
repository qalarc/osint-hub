00293|   // ------------------------------------------------------------- actions
00294|   private actionsSection(e: Entity): HTMLElement {
00295|     const caseId = this.cb.caseId();
00296|     const post = (kind: string, params: Record<string, unknown>, okMsg: string): void => {
00297|       if (!caseId) { toast('no case selected', 'warn'); return; }
00298|       void guarded(api.createTask(caseId, { kind, target: e.id, params }).then((t) => {
00299|         this.cb.taskStarted(t);
00300|         return t;
00301|       }), okMsg);
00302|     };
00303| 
00304|     const askQuestion = (title: string, kind: string): void => {
00305|       void inputModal(title, 'question', 'what should the agent dig into?').then((q) => {
00306|         if (q === null) return;
00307|         if (!q) { toast('question required', 'warn'); return; }
00308|         post(kind, { question: q }, `${kind} task queued`);
00309|       });
00310|     };
00311| 
00312|     const pivotsWrap = h('div', { class: 'pivots-wrap', hidden: true });
00313|     const togglePivots = async (): Promise<void> => {
00314|       if (!caseId) return;
00315|       if (!pivotsWrap.hidden) { pivotsWrap.hidden = true; return; }
00316|       pivotsWrap.hidden = false;
00317|       clear(pivotsWrap);
00318|       pivotsWrap.append(h('div', { class: 'muted small pad6' }, 'loading pivots…'));
00319|       try {
00320|         const { pivots } = await api.getPivots(caseId, e.id);
00321|         clear(pivotsWrap);
00322|         if (pivots.length === 0) {
00323|           pivotsWrap.append(h('div', { class: 'muted small pad6' }, 'no pivot suggestions'));
00324|         }
00325|         for (const p of pivots) pivotsWrap.append(this.pivotCard(p, e));
00326|       } catch (err) {
00327|         clear(pivotsWrap);
00328|         pivotsWrap.append(h('div', { class: 'small pad6 error-text' }, String(err instanceof Error ? err.message : err)));
00329|       }
00330|     };
00331| 
00332|     // merge modal
00333|     const mergeInto = (): void => {
00334|       const others = this.cb.entities().filter((x) => x.id !== e.id);
00335|       if (others.length === 0) { toast('no other entities to merge with', 'warn'); return; }
00336|       void inputModal('merge entity', `merge "${e.label}" into (type to search):`, 'search entities…').then((q) => {
00337|         if (q === null || !q) return;
00338|         const needle = q.toLowerCase();
00339|         const hit = others.find((x) => x.label.toLowerCase().includes(needle))
00340|           ?? others.find((x) => x.id.toLowerCase() === needle);
00341|         if (!hit) { toast(`no entity matching "${q}"`, 'warn'); return; }
00342|         if (!window.confirm(`Merge "${e.label}" into "${hit.label}"? Relations re-point; a same_as edge is kept.`)) return;
00343|         void guarded(api.mergeEntity(hit.id, e.id).then((merged) => {
00344|           this.cb.graphChanged();
00345|           this.open(merged.id);
00346|           return merged;
00347|         }), `merged into ${hit.label}`);
00348|       });
00349|     };
00350| 
00351|     return h('div', { class: 'field actions-field' },
00352|       h('span', { class: 'panel-label' }, 'actions'),
00353|       h('div', { class: 'actions-grid' },
00354|         h('button', {
00355|           class: 'btn btn-sm', type: 'button',
00356|           title: `hub multi-scan (${scanKindFor(String(e.etype))})`,
00357|           onclick: () => post('hub_scan', { scan: scanKindFor(String(e.etype)), value: e.label }, 'hub_scan queued'),
00358|         }, '▶ hub scan'),
00359|         h('button', {
00360|           class: 'btn btn-sm', type: 'button',
00361|           title: `flowsint enrichers: ${enrichersFor(String(e.etype)).join(', ')}`,
00362|           onclick: () => post('flowsint_enrich', { enrichers: enrichersFor(String(e.etype)) }, 'flowsint_enrich queued'),
00363|         }, '▶ flowsint enrich'),
00364|         h('button', { class: 'btn btn-sm', type: 'button', onclick: () => askQuestion('openplanter research', 'openplanter_research') }, '▶ openplanter research'),
00365|         h('button', { class: 'btn btn-sm', type: 'button', onclick: () => askQuestion('archon ground', 'archon_ground') }, '▶ archon ground'),
00366|         h('button', {
00367|           class: 'btn btn-sm', type: 'button', onclick: () => void togglePivots(),
00368|         }, '◇ pivots'),
00369|         h('button', { class: 'btn btn-sm', type: 'button', onclick: () => post('web_pivots', {}, 'web_pivots queued') }, '▶ web pivots'),
00370|         h('button', { class: 'btn btn-sm', type: 'button', onclick: () => mergeInto() }, '⇉ merge…'),
00371|         h('button', {
00372|           class: 'btn btn-sm btn-danger', type: 'button',
00373|           onclick: () => {
00374|             if (!window.confirm(`Delete entity "${e.label}"? Its relations detach; evidence stays on the case.`)) return;
00375|             void guarded(api.deleteEntity(e.id), () => {
00376|               this.close();
00377|               this.cb.graphChanged();
00378|               return 'entity deleted';
00379|             });
00380|           },
00381|         }, '✕ delete'),
00382|       ),
00383|       pivotsWrap,
00384|     );
00385|   }
