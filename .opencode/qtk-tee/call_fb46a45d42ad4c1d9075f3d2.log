00279|   private relRow(r: Relation, selfId: string): HTMLElement {
00280|     const other = r.src === selfId ? r.dst : r.src;
00281|     const dir = r.src === selfId ? '→' : '←';
00282|     return h('div', {
00283|       class: 'rel-item', tabindex: '0', title: `rel ${dir} ${this.cb.labelOf(other)}`,
00284|       onclick: () => this.cb.navigate(other),
00285|       onkeydown: (e: KeyboardEvent) => { if (e.key === 'Enter') this.cb.navigate(other); },
00286|     },
00287|       h('span', { class: 'rel-dir' }, dir),
00288|       h('span', { class: 'chip chip-rel' }, r.rel),
00289|       h('span', { class: 'rel-other' }, truncate(this.cb.labelOf(other), 34)),
00290|     );
00291|   }
