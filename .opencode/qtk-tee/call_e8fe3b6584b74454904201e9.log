00098| 00097| 
00099| 00098| /** RFC3339 → "YYYY-MM-DD HH:MM" local. */
00100| 00099| export function fmtTs(iso: string | null | undefined): string {
00101| 00100|   if (!iso) return '—';
00102| 00101|   const d = new Date(iso);
00103| 00102|   if (Number.isNaN(d.getTime())) return iso;
00104| 00103|   const p = (n: number): string => String(n).padStart(2, '0');
00105| 00104|   return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ` +
00106| 00105|     `${p(d.getHours())}:${p(d.getMinutes())}`;
00107| 00106| }
00108| 00107| 
00109| 00108| export function timeAgo(iso: string | null | undefined): string {
00110| 00109|   if (!iso) return '—';
00111| 00110|   const t = new Date(iso).getTime();
00112| 00111|   if (Number.isNaN(t)) return iso;
00113| 00112|   const s = Math.max(0, Math.floor((Date.now() - t) / 1000));
00114| 00113|   if (s < 45) return 'just now';
00115| 00114|   const m = Math.floor(s / 60);
00116| 00115|   if (m < 60) return `${m}m ago`;
00117| 00116|   const hr = Math.floor(m / 60);
00118| 00117|   if (hr < 24) return `${hr}h ago`;
00119| 00118|   const d = Math.floor(hr / 24);
00120| 00119|   if (d < 14) return `${d}d ago`;
00121| 00120|   return fmtTs(iso);
00122| 00121| }
00123| 00122| 
00124| 00123| /** Elapsed between created_at and finished_at (or now), human short. */
00125| 00124| export function elapsed(created: string, finished?: string | null): string {
00126| 00125|   const a = new Date(created).getTime();
00127| 00126|   const b = finished ? new Date(finished).getTime() : Date.now();
00128| 00127|   if (Number.isNaN(a) || Number.isNaN(b)) return '—';
00129| 00128|   let s = Math.max(0, Math.floor((b - a) / 1000));
00130| 00129|   const hr = Math.floor(s / 3600); s -= hr * 3600;
00131| 00130|   const m = Math.floor(s / 60); s -= m * 60;
00132| 00131|   if (hr > 0) return `${hr}h${p2(m)}m`;
00133| 00132|   if (m > 0) return `${m}m${p2(s)}s`;
00134| 00133|   return `${s}s`;
00135| 00134| }
00136| 00135| 
00137| 00136| function p2(n: number): string { return String(n).padStart(2, '0'); }
00138| 00137| 
00139| 00138| export function truncate(s: string, n: number): string {
00140| 00139|   return s.length > n ? s.slice(0, n - 1) + '…' : s;
