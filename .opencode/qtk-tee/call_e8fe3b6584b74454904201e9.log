00175| 00174| /** Prompt-style modal with a single text input. Resolves null on cancel. */
00176| 00175| export function inputModal(
00177| 00176|   title: string, label: string, placeholder = '',
00178| 00177| ): Promise<string | null> {
00179| 00178|   return new Promise((resolve) => {
00180| 00179|     let done = false;
00181| 00180|     const finish = (v: string | null): void => {
00182| 00181|       if (done) return;
00183| 00182|       done = true;
00184| 00183|       resolve(v);
00185| 00184|       m.close();
00186| 00185|     };
00187| 00186|     const input = h('input', { class: 'input', placeholder, type: 'text', spellcheck: 'false' }) as HTMLInputElement;
00188| 00187|     const m = openModal(title, (body, _close) => {
00189| 00188|       body.append(
00190| 00189|         h('label', { class: 'field-label' }, label),
00191| 00190|         input,
00192| 00191|         h('div', { class: 'row row-end gap8' },
00193| 00192|           h('button', { class: 'btn', type: 'button', onclick: () => finish(null) }, 'Cancel'),
00194| 00193|           h('button', {
00195| 00194|             class: 'btn btn-primary', type: 'button',
00196| 00195|             onclick: () => finish(input.value.trim()),
00197| 00196|           }, 'OK'),
00198| 00197|         ),
00199| 00198|       );
00200| 00199|       input.addEventListener('keydown', (e) => {
00201| 00200|         if (e.key === 'Enter') finish(input.value.trim());
00202| 00201|       });
00203| 00202|     });
00204| 00203|     void m;
00205| 00204|   });
00206| 00205| }
