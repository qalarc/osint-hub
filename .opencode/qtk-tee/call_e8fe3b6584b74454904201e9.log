00081| 00080| /** Run a promise; toast errors (esp. ApiError); optional success message. */
00082| 00081| export async function guarded<T>(
00083| 00082|   p: Promise<T>,
00084| 00083|   okMsg?: string | ((result: T) => string),
00085| 00084| ): Promise<T | undefined> {
00086| 00085|   try {
00087| 00086|     const r = await p;
00088| 00087|     if (okMsg) toast(typeof okMsg === 'function' ? okMsg(r) : okMsg, 'ok');
00089| 00088|     return r;
00090| 00089|   } catch (e) {
00091| 00090|     if (e instanceof Error && e.name === 'AbortError') return undefined;
00092| 00091|     toast(e instanceof Error ? e.message : String(e), 'error');
00093| 00092|     return undefined;
00094| 00093|   }
00095| 00094| }
