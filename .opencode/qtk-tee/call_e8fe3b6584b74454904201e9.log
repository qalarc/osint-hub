00145| 00144| /** Generic centered modal. Returns {close}. Backdrop click / Esc close. */
00146| 00145| export function openModal(
00147| 00146|   title: string,
00148| 00147|   build: (body: HTMLElement, close: () => void) => void,
00149| 00148|   opts?: { wide?: boolean },
00150| 00149| ): { close: () => void } {
00151| 00150|   const backdrop = h('div', { class: 'modal-backdrop' });
00152| 00151|   const close = (): void => {
00153| 00152|     backdrop.classList.remove('in');
00154| 00153|     window.setTimeout(() => backdrop.remove(), 150);
00155| 00154|     document.removeEventListener('keydown', onKey);
00156| 00155|   };
00157| 00156|   const onKey = (e: KeyboardEvent): void => { if (e.key === 'Escape') close(); };
00158| 00157|   document.addEventListener('keydown', onKey);
00159| 00158|   const panel = h('div', { class: `modal${opts?.wide ? ' modal-wide' : ''}`, role: 'dialog', 'aria-modal': 'true' },
00160| 00159|     h('div', { class: 'modal-head' },
00161| 00160|       h('span', { class: 'panel-label' }, title),
00162| 00161|       h('button', { class: 'btn btn-ghost btn-sm', onclick: close, 'aria-label': 'close', type: 'button' }, '✕'),
00163| 00162|     ),
00164| 00163|     ((): HTMLElement => { const b = h('div', { class: 'modal-body' }); build(b, close); return b; })(),
00165| 00164|   );
00166| 00165|   backdrop.append(panel);
00167| 00166|   backdrop.addEventListener('mousedown', (e) => { if (e.target === backdrop) close(); });
00168| 00167|   document.body.append(backdrop);
00169| 00168|   requestAnimationFrame(() => backdrop.classList.add('in'));
00170| 00169|   const first = panel.querySelector<HTMLElement>('input, textarea, select, button');
00171| 00170|   first?.focus();
00172| 00171|   return { close };
00173| 00172| }
