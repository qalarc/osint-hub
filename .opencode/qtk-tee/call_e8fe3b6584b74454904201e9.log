00044| 00043| export type ToastKind = 'info' | 'ok' | 'warn' | 'error';
00045| 00044| 
00046| 00045| let toastRoot: HTMLElement | null = null;
00047| 00046| 
00048| 00047| function ensureToastRoot(): HTMLElement {
00049| 00048|   if (!toastRoot) {
00050| 00049|     toastRoot = h('div', { id: 'toasts', 'aria-live': 'polite' });
00051| 00050|     document.body.append(toastRoot);
00052| 00051|   }
00053| 00052|   return toastRoot;
00054| 00053| }
00055| 00054| 
00056| 00055| let lastToastAt: Record<string, number> = {};
00057| 00056| 
00058| 00057| export function toast(msg: string, kind: ToastKind = 'info', ms = 4200): void {
00059| 00058|   // rate-limit identical messages (e.g. SSE-driven retries)
00060| 00059|   const now = Date.now();
00061| 00060|   if (lastToastAt[msg] && now - lastToastAt[msg] < 3000) return;
00062| 00061|   lastToastAt[msg] = now;
00063| 00062|   const root = ensureToastRoot();
00064| 00063|   const t = h('div', { class: `toast toast-${kind}`, role: 'status' },
00065| 00064|     h('span', { class: 'toast-msg' }, msg),
00066| 00065|     h('button', {
00067| 00066|       class: 'toast-x', 'aria-label': 'dismiss', type: 'button',
00068| 00067|       onclick: () => t.remove(),
00069| 00068|     }, '✕'),
00070| 00069|   );
00071| 00070|   root.append(t);
00072| 00071|   requestAnimationFrame(() => t.classList.add('in'));
00073| 00072|   window.setTimeout(() => {
00074| 00073|     t.classList.remove('in');
00075| 00074|     window.setTimeout(() => t.remove(), 300);
00076| 00075|   }, ms);
00077| 00076|   // gc the rate-limit map
00078| 00077|   if (Object.keys(lastToastAt).length > 64) lastToastAt = {};
00079| 00078| }
