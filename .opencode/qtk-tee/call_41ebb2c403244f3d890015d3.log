00171| export class GraphView {
00172|   readonly cy: cytoscape.Core;
00173|   private layoutName: LayoutName = 'fcose';
00174|   private filters: GraphFilterState = { search: '', hiddenEtypes: new Set() };
00175|   private entityById = new Map<string, Entity>();
00176|   private ro: ResizeObserver | null = null;
00177| 
00178|   constructor(container: HTMLElement) {
