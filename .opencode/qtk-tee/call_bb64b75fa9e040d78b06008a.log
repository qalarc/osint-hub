00071| export class ApiError extends Error {
00072|   readonly status: number;
00073|   constructor(status: number, message: string) {
00074|     super(message);
00075|     this.name = 'ApiError';
00076|     this.status = status;
00077|   }
00078| }
00079| 
00080| function errFromBody(status: number, body: unknown): ApiError {
00081|   if (body && typeof body === 'object' && 'error' in body) {
00082|     const e = (body as { error: unknown }).error;
00083|     if (typeof e === 'string' && e) return new ApiError(status, e);
00084|   }
00085|   return new ApiError(status, `${status} ${STATUS_TEXT[status] ?? ''}`.trim());
00086| }
00087| 
00088| const STATUS_TEXT: Record<number, string> = {
00089|   400: 'bad request', 401: 'unauthorized', 403: 'forbidden', 404: 'not found',
00090|   409: 'conflict', 422: 'unprocessable', 500: 'internal error', 502: 'bad gateway',
00091|   503: 'unavailable',
00092| };
00093| 
00094| async function request<T>(path: string, init?: RequestInit): Promise<T> {
00095|   const headers: Record<string, string> = { ...authHeaders() };
00096|   if (init?.headers) {
00097|     for (const [k, v] of new Headers(init.headers)) headers[k.toLowerCase()] = v;
00098|   }
00099|   let res: Response;
00100|   try {
00101|     res = await fetch(withBase(`/api${path}`), { cache: 'no-store', ...init, headers });
00102|   } catch (e) {
00103|     throw new ApiError(0, `network error — is the nexus server up? (${String(e)})`);
00104|   }
00105|   const text = await res.text();
00106|   let body: unknown = null;
00107|   if (text.length > 0) {
00108|     try { body = JSON.parse(text); } catch { body = null; }
00109|   }
00110|   if (!res.ok) throw errFromBody(res.status, body);
00111|   return body as T;
00112| }
00113| 
00114| async function requestText(path: string): Promise<string> {
00115|   let res: Response;
00116|   try {
00117|     res = await fetch(withBase(`/api${path}`), { cache: 'no-store', headers: authHeaders() });
00118|   } catch (e) {
00119|     throw new ApiError(0, `network error — is the nexus server up? (${String(e)})`);
00120|   }
00121|   const text = await res.text();
00122|   if (!res.ok) {
00123|     let body: unknown = null;
00124|     try { body = JSON.parse(text); } catch { body = null; }
00125|     throw errFromBody(res.status, body);
00126|   }
00127|   return text;
00128| }
00129| 
00130| function json(method: string, payload?: unknown): RequestInit {
00131|   return {
00132|     method,
00133|     headers: { 'content-type': 'application/json' },
00134|     body: payload === undefined ? undefined : JSON.stringify(payload),
00135|   };
00136| }
