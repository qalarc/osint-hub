00001| /**
00002|  * Typed API client for the nexus-server HTTP surface (CONTRACT.md §4).
00003|  * Every fetch is cache: no-store; `{"error": ...}` bodies become ApiError
00004|  * for the UI to toast.
00005|  *
00006|  * Connection settings (browser-local, NOT part of nexus_settings):
00007|  * - API base — resolved once at module load: `?api=<url>` query param
00008|  *   (persisted to localStorage) → localStorage `nexus_api_base` → same-origin.
00009|  *   Lets a statically-hosted UI talk to a remote nexus server.
00010|  * - Bearer token — localStorage `nexus_token`; attached as
00011|  *   `Authorization: Bearer <redacted> to every API + SSE request when set
00012|  *   (server gate: NEXUS_TOKEN env; /api/health stays open).
00013|  */
00014| import type {
00015|   Case, CaseGraph, Entity, EntityDetail, Evidence, Health, LayaRanked,
00016|   PivotSuggestion, Relation, Task, TimelineEvent, NexusSettings,
00017| } from './types';
00018| 
00019| const LS_API_BASE = 'nexus_api_base';
00020| const LS_TOKEN = 'nexus_token';
00021| 
00022| /** Persist browser-connection fields (settings modal Save). Base change needs a reload. */
00023| export function saveConnection(apiBase: string, token: string): void {
00024|   try {
00025|     localStorage.setItem(LS_API_BASE, normalizeBase(apiBase));
00026|     localStorage.setItem(LS_TOKEN, token.trim());
00027|   } catch { /* storage unavailable */ }
00028| }
00029| 
00030| function resolveApiBase(): string {
00031|   try {
00032|     const q = new URLSearchParams(window.location.search).get('api');
00033|     if (q !== null) {
00034|       const b = normalizeBase(q);
00035|       localStorage.setItem(LS_API_BASE, b); // sticky: '' = same-origin
00036|       return b;
00037|     }
00038|     return normalizeBase(localStorage.getItem(LS_API_BASE));
00039|   } catch {
00040|     return ''; // no storage / no window — same-origin default
00041|   }
00042| }
00043| 
00044| /** Resolved API base ('' = same-origin). Change requires a reload (settings modal handles it). */
00045| export const API_BASE: string = resolveApiBase();
00046| 
00047| /** Prefix a root-relative path ('/api/…') with the configured base. */
00048| export function withBase(path: string): string {
00049|   return `${API_BASE}${path}`;
00050| }
00051| 
00052| /** Same normalization resolveApiBase applies (trim + strip trailing slashes). */
00053| export function normalizeBase(v: string | null | undefined): string {
00054|   return (v ?? '').trim().replace(/\/+$/, '');
00055| }
00056| 
00057| /** `Authorization: Bearer <redacted> headers for the nexus server when a token is set. */
00058| export function authHeaders(): Record<string, string> {
00059|   try {
00060|     const token = (localStorage.getItem(LS_TOKEN) ?? '').trim();
00061|     if (token) return { authorization: `Bearer ${token}` };
00062|   } catch { /* storage unavailable */ }
00063|   return {};
00064| }
00065| 
00066| /** Currently stored bearer token ('' = none) — for the settings modal display. */
00067| export function storedToken(): string {
00068|   try { return localStorage.getItem(LS_TOKEN) ?? ''; } catch { return ''; }
00069| }
