00187| 
00188|     // sticky in-page TOC from the slug ids md.ts generates for h2/h3
00189|     const tocLinks: HTMLElement[] = [];
00190|     for (const hd of Array.from(md.querySelectorAll('h2[id], h3[id]'))) {
00191|       const a = h('a', {
00192|         class: `toc-l${hd.tagName === 'H3' ? ' toc-l3' : ''}`,
00193|         href: `#${hd.id}`,
00194|         title: hd.textContent ?? hd.id,
00195|       }, hd.textContent ?? hd.id);
00196|       a.addEventListener('click', (e) => {
00197|         e.preventDefault();
00198|         try { history.replaceState(null, '', `#${hd.id}`); } catch { /* file:// quirks */ }
00199|         hd.scrollIntoView({ behavior: 'smooth', block: 'start' });
00200|       });
00201|       tocLinks.push(a);
00202|     }
00203|     const toc = h('nav', { class: 'guide-toc', 'aria-label': 'guide table of contents' },
00204|       h('span', { class: 'panel-label' }, 'contents'),
00205|       h('div', { class: 'guide-toc-links' }, tocLinks),
00206|     );
00207| 
00208|     this.el = h('section', { class: 'pane', id: 'pane-guide', hidden: true },
00209|       h('header', { class: 'pane-head' },
00210|         h('span', { class: 'panel-label' }, 'guide'),
00211|         h('span', { class: 'muted small' }, 'field handbook — both layers, end to end'),
00212|       ),
00213|       h('div', { class: 'pane-body guide-body' }, toc, md),
00214|     );
00215|   }
00216| }
