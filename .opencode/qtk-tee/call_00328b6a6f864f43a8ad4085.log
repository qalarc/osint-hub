00001| /**
00002|  * Guide tab: the in-app field handbook, one long markdown document rendered
00003|  * through md.ts (which gives h2/h3 slug ids). A sticky in-page TOC is built
00004|  * from the generated ids. Static content — no server calls, no refresh().
00005|  */
00006| import { h } from './dom';
00007| import { renderMarkdownInto } from './md';
