00368| @mcp.tool()
00369| def osint_dating(username: str, max_wait: float = 300.0) -> dict:
00370|     """Dating-platform sweep for a username (Tinder/Badoo/MeetMe/AFF/…) via maigret.
00371|     Full backend only. Filters results to dating domains. Responsible use only."""
00372|     base, mode = _resolve()
00373|     if base is None or mode == "lite":
00374|         return {"error": "dating sweeps need the full backend (maigret, 3000+ sites)"}
00375|     r = _http(
00376|         "POST",
00377|         base + "/api/scan",
00378|         {
00379|             "type": "username",
00380|             "value": username,
00381|             "tools": ["maigret"],
00382|             "options": {"timeout": 15},
00383|         },
00384|     )
00385|     if "job_id" not in r:
00386|         return {"error": "scan rejected", "detail": r}
00387|     job = _wait_job(base, r["job_id"], max_wait)
00388|     hits = []
00389|     for res in job.get("results", []):
00390|         for f in res.get("found", []):
00391|             url = f.get("url") or ""
00392|             try:
00393|                 host = urllib.parse.urlparse(url).hostname or ""
00394|             except ValueError:
00395|                 host = ""
00396|             if any(host == d or host.endswith("." + d) for d in DATING_DOMAINS):
00397|                 hits.append({"site": f.get("site"), "url": url})
00398|     all_found = sum(len(x.get("found", [])) for x in job.get("results", []))
00399|     return {
00400|         "username": username,
00401|         "status": job.get("status"),
00402|         "total_accounts_found": all_found,
00403|         "dating_hits": hits,
00404|         "note": "dating-only filter; run osint_case for the full picture",
00405|     }
