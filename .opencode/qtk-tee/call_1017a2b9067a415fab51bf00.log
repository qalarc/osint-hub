00001| #!/usr/bin/env python
00002| """OSINT Hub MCP server — agent-facing OSINT tools (stdio transport).
00003| 
00004| Auto-resolves which hub to talk to:
00005|   1. $OSINT_HUB_URL (explicit override)
00006|   2. local full backend  http://127.0.0.1:8799   (sherlock/maigret/phoneinfoga/holehe/revimg)
00007|   3. live lite engine    https://osint.qalarc.com (edge username checks + phone pivots)
00008| 
00009| Tools:
00010|   osint_status()               – mode + capabilities of the connected hub
00011|   osint_case()                 – one call: username + phone + email + image URL
00012|   osint_username/phone/email() – focused single-subject scans
00013|   osint_image_search()         – reverse-image discovery: pages where a photo appears
00014|   osint_dating()               – dating-platform scan (maigret, full backend only)
00015|   osint_search_pivots()        – instant topic/person search launchers (no hub needed)
00016| 
00017| Run:    backend/.venv/bin/python mcp/server.py
00018| Env:    OSINT_HUB_URL, OSINT_HUB_TOKEN (if the hub requires auth)
00019| Results are heuristic — agents should verify before acting on findings.
00020| """
00021| 
00022| from __future__ import annotations
00023| 
00024| import asyncio
00025| import json
00026| import os
00027| import time
00028| import urllib.error
00029| import urllib.parse
00030| import urllib.request
00031| 
00032| from mcp.server.mcpserver import MCPServer
00033| 
00034| mcp = MCPServer(
00035|     name="osint-hub",
00036|     instructions=(
00037|         "Qalarc OSINT tools. Call osint_status() first to see the connected mode. "
00038|         "osint_case() accepts any mix of username / phone / email / image_url and returns "
00039|         "per-subject findings. osint_dating() sweeps dating platforms (full backend only). "
00040|         "osint_search_pivots(topic) gives instant search launchers with no hub required. "
00041|         "Findings are heuristic (false positives/negatives happen) — verify before acting."
00042|     ),
00043| )
00044| 
00045| TOKEN = os.environ.get("OSINT_HUB_TOKEN", "")
00046| _CANDIDATES: list[str] = []
00047| if os.environ.get("OSINT_HUB_URL"):
00048|     _CANDIDATES.append(os.environ["OSINT_HUB_URL"].rstrip("/"))
00049| _CANDIDATES += ["http://127.0.0.1:8799", "https://osint.qalarc.com"]
00050| 
00051| DATING_DOMAINS = {
00052|     "tinder.com",
00053|     "badoo.com",
00054|     "meetme.com",
00055|     "adultfriendfinder.com",
00056|     "okcupid.com",
00057|     "pof.com",
00058|     "match.com",
00059|     "hinge.co",
00060|     "bumble.com",
00061|     "grindr.com",
00062|     "feeld.co",
00063|     "zoosk.com",
00064|     "ashleymadison.com",
00065|     "eharmony.com",
00066| }
00067| 
00068| _ALL_TOOLS = ["sherlock", "maigret", "phoneinfoga", "ignorant", "holehe", "revimg"]
00069| _cache: dict = {"base": None, "mode": None}
00070| 
00071| 
00072| # ---------------------------------------------------------------- hub client
00073| def _http(method: str, url: str, body=None, timeout: float = 45):
00074|     data = json.dumps(body).encode() if body is not None else None
00075|     req = urllib.request.Request(url, data=data, method=method)
00076|     req.add_header("Content-Type", "application/json")
00077|     # browser-ish UA: Cloudflare bot protection 403s the default Python-urllib UA
00078|     req.add_header(
00079|         "User-Agent",
00080|         "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36 qalarc-osint-mcp/1.0",
00081|     )
00082|     if TOKEN:
00083|         req.add_header("Authorization", f"Bearer {TOKEN}")
00084|     with urllib.request.urlopen(req, timeout=timeout) as r:
00085|         raw = r.read().decode()
00086|         return json.loads(raw) if raw else {}
00087| 
00088| 
00089| def _health(base: str):
00090|     try:
00091|         h = _http("GET", base + "/api/health", timeout=6)
00092|         return h if h.get("ok") else None
00093|     except Exception:
00094|         return None
00095| 
00096| 
00097| def _resolve():
00098|     """Return (base_url, mode) — 'full' or 'lite' — or (None, None)."""
00099|     if _cache["base"]:
00100|         h = _health(_cache["base"])
00101|         if h:
00102|             _cache["mode"] = h.get("mode", "full")
00103|             return _cache["base"], _cache["mode"]
00104|         _cache.update(base=None, mode=None)
00105|     for base in _CANDIDATES:
00106|         h = _health(base)
00107|         if h:
00108|             _cache.update(base=base, mode=h.get("mode", "full"))
00109|             return base, _cache["mode"]
00110|     return None, None
00111| 
00112| 
00113| def _wait_job(base: str, job_id: str, timeout: float):
00114|     deadline = time.time() + timeout
00115|     while time.time() < deadline:
00116|         j = _http("GET", f"{base}/api/jobs/{job_id}")
00117|         if j.get("status") in ("done", "error", "timeout"):
00118|             return j
00119|         time.sleep(2.5)
00120|     return {"id": job_id, "status": "timeout", "results": []}
00121| 
00122| 
00123| def _digest(job: dict, cap: int = 60) -> dict:
00124|     out = {"job": job.get("id"), "status": job.get("status"), "subjects": {}}
00125|     for r in job.get("results", []):
00126|         qt = r.get("qtype", "?")
00127|         subject = out["subjects"].setdefault(
00128|             qt, {"value": r.get("qvalue"), "tools": {}}
00129|         )
00130|         t = subject["tools"].setdefault(r["tool"], {"status": r.get("status")})
00131|         if r.get("error"):
00132|             t["error"] = r["error"]
00133|         found = r.get("found") or []
00134|         if found:
00135|             t["found_count"] = len(found)
00136|             t["found"] = [
00137|                 {"site": f.get("site"), **({"url": f["url"]} if f.get("url") else {})}
00138|                 for f in found[:cap]
00139|             ]
00140|             if len(found) > cap:
00141|                 t["truncated"] = f"+{len(found) - cap} more"
00142|         info = r.get("info") or []
00143|         if info:
00144|             facts = [i for i in info if i.get("value")]
00145|             pivots = [i.get("url") for i in info if i.get("url")][:20]
00146|             if facts:
00147|                 t["facts"] = {i["key"]: i["value"] for i in facts}
00148|             if pivots:
00149|                 t["search_pivots"] = pivots
00150|     return out
00151| 
00152| 
00153| def _full_scan(value: dict, max_wait: float) -> dict:
00154|     base, mode = _resolve()
00155|     if base is None:
00156|         return {
00157|             "error": "no OSINT hub reachable — start the backend (scripts/run.sh) or set OSINT_HUB_URL"
00158|         }
00159|     if mode == "lite":
00160|         return {
00161|             "error": "connected hub is lite mode (edge) — only username checks and phone pivots are available; start the full backend for this scan",
00162|             "hub": base,
00163|         }
00164|     r = _http(
00165|         "POST",
00166|         base + "/api/scan",
00167|         {
00168|             "type": "multi",
00169|             "value": value,
00170|             "tools": _ALL_TOOLS,
00171|             "options": {"timeout": 10},
00172|         },
00173|     )
00174|     if "job_id" not in r:
00175|         return {"error": "scan rejected", "detail": r}
00176|     job = _wait_job(base, r["job_id"], max_wait)
00177|     d = _digest(job)
00178|     d["hub"] = base
00179|     return d
00180| 
00181| 
00182| def _lite_or_full_case(
00183|     username=None, phone=None, email=None, image_url=None, max_wait=180.0
00184| ) -> dict:
00185|     value = {
00186|         k: v
00187|         for k, v in {
00188|             "username": username,
00189|             "phone": phone,
00190|             "email": email,
00191|             "image": image_url,
00192|         }.items()
00193|         if v
00194|     }
00195|     if not value:
00196|         return {"error": "provide at least one of: username, phone, email, image_url"}
00197|     base, mode = _resolve()
00198|     if base is None:
00199|         return {
00200|             "error": "no OSINT hub reachable — start the backend (scripts/run.sh) or set OSINT_HUB_URL"
00201|         }
00202|     if mode == "full":
00203|         return _full_scan(value, max_wait)
00204|     # ---- lite mode: synchronous edge endpoints ----
00205|     out = {"hub": base, "mode": "lite", "subjects": {}}
00206|     if value.get("username"):
00207|         try:
00208|             r = _http(
00209|                 "POST",
00210|                 base + "/api/lite/check",
00211|                 {"value": value["username"]},
00212|                 timeout=60,
00213|             )
00214|             out["subjects"]["username"] = {
00215|                 "value": value["username"],
00216|                 "tools": {
00217|                     "cloudcheck": {
00218|                         "status": "done",
00219|                         "found_count": len(r.get("found", [])),
00220|                         "found": r.get("found", [])[:60],
00221|                     }
00222|                 },
00223|             }
00224|         except Exception as exc:
00225|             out["subjects"]["username"] = {"error": str(exc)[:200]}
00226|     if value.get("phone"):
00227|         try:
00228|             r = _http(
00229|                 "POST", base + "/api/lite/pivots", {"value": value["phone"]}, timeout=30
00230|             )
00231|             info = r.get("info", [])
00232|             out["subjects"]["phone"] = {
00233|                 "value": value["phone"],
00234|                 "tools": {
00235|                     "pivots": {
00236|                         "status": "done",
00237|                         "facts": {i["key"]: i["value"] for i in info if i.get("value")},
00238|                         "search_pivots": [i.get("url") for i in info if i.get("url")][
00239|                             :20
00240|                         ],
00241|                     }
00242|                 },
00243|             }
00244|         except Exception as exc:
00245|             out["subjects"]["phone"] = {"error": str(exc)[:200]}
00246|     if value.get("email"):
00247|         out["subjects"]["email"] = {
00248|             "error": "email checks (holehe) need the full backend"
00249|         }
00250|     if value.get("image"):
00251|         out["subjects"]["image"] = {
00252|             "error": "image discovery (revimg) needs the full backend"
00253|         }
00254|     return out
