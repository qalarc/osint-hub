00309| # ---------------------------------------------------------------- MCP tools
00310| @mcp.tool()
00311| def osint_status() -> dict:
00312|     """Which OSINT hub is connected: base URL, mode (full/lite), installed tools."""
00313|     base, mode = _resolve()
00314|     if base is None:
00315|         return {
00316|             "connected": False,
00317|             "hint": "start the backend (scripts/run.sh) or set OSINT_HUB_URL; lite fallback https://osint.qalarc.com",
00318|         }
00319|     try:
00320|         tools = {
00321|             t["id"]: t["installed"]
00322|             for t in _http("GET", base + "/api/tools").get("tools", [])
00323|         }
00324|     except Exception:
00325|         tools = {}
00326|     return {"connected": True, "hub": base, "mode": mode, "tools": tools}
