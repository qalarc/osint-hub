00257| # ---------------------------------------------------------------- local tools
00258| def _pivot_urls(topic: str, kind: str) -> dict:
00259|     q = urllib.parse.quote_plus(topic)
00260|     quoted = urllib.parse.quote_plus(f'"{topic}"')
00261|     links = [
00262|         ("google", f"https://www.google.com/search?q={q}"),
00263|         ("bing", f"https://www.bing.com/search?q={q}"),
00264|         ("duckduckgo", f"https://duckduckgo.com/?q={q}"),
00265|         ("google-news", f"https://news.google.com/search?q={q}"),
00266|         ("wikipedia", f"https://en.wikipedia.org/w/index.php?search={q}"),
00267|         ("reddit", f"https://www.google.com/search?q=site%3Areddit.com+{q}"),
00268|         ("youtube", f"https://www.youtube.com/results?search_query={q}"),
00269|     ]
00270|     if kind == "person":
00271|         socials = [
00272|             "facebook.com",
00273|             "instagram.com",
00274|             "linkedin.com",
00275|             "x.com",
00276|             "tiktok.com",
00277|             "tinder.com/@{u}",
00278|         ]
00279|         person = (
00280|             topic.split()[0] if " " not in topic else topic.split()[-1]
00281|         )  # last name guess
00282|         username_guess = "".join(c for c in topic.lower() if c.isalnum())[:20]
00283|         for s in socials[:5]:
00284|             links.append(
00285|                 (
00286|                     f"google-site:{s}",
00287|                     f"https://www.google.com/search?q={quoted}+site%3A{s}",
00288|                 )
00289|             )
00290|         links += [
00291|             ("exact-phrase", f"https://www.google.com/search?q={quoted}"),
00292|             (
00293|                 "username-guess",
00294|                 f"https://osint.qalarc.com/#case (scan username: {username_guess})",
00295|             ),
00296|             ("tinder-handle-guess", f"https://tinder.com/@{username_guess}"),
00297|             (
00298|                 "maigret-dating",
00299|                 "ask agent: osint_dating(username) with the full backend",
00300|             ),
00301|         ]
00302|     return {
00303|         "topic": topic,
00304|         "kind": kind,
00305|         "pivots": [{"engine": e, "url": u} for e, u in links],
00306|     }
